#!/bin/sh
# @{...} denotes a native identifier placeholder, not standard shell syntax.
set -eu
@{plik_źródłowy}=$1
@{plik_obiektowy}=$2
@{plik_wykonywalny}=$3
@{katalog_deklaracji}=$4
@{obiekt_startowy}=$5
@{plik_biblioteki}=$6
@{plik_konsolidacji}=$7

@{zbuduj_interpretator}() {
    gcc -m32 -std=c99 -ffreestanding -fno-pie -fno-pic -fno-stack-protector \
        -fno-builtin -Wall -Wextra -Werror -nostdinc \
        -I"$@{katalog_deklaracji}" -c "$@{plik_źródłowy}" -o "$@{plik_obiektowy}"
    ld -n -m elf_i386 -e _start -T "$@{plik_konsolidacji}" -static \
        --no-ld-generated-unwind-info -o "$@{plik_wykonywalny}" \
        "$@{obiekt_startowy}" "$@{plik_obiektowy}" "$@{plik_biblioteki}"
}
@{zbuduj_interpretator}
