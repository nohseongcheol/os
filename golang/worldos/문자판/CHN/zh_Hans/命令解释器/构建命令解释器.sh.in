#!/bin/sh
# @{...} denotes a native identifier placeholder, not standard shell syntax.
set -eu
@{源文件}=$1
@{目标文件}=$2
@{可执行文件}=$3
@{头文件目录}=$4
@{启动目标文件}=$5
@{库文件}=$6
@{链接布局文件}=$7

@{构建命令解释器}() {
    gcc -m32 -std=c99 -ffreestanding -fno-pie -fno-pic -fno-stack-protector \
        -fno-builtin -Wall -Wextra -Werror -nostdinc \
        -I"$@{头文件目录}" -c "$@{源文件}" -o "$@{目标文件}"
    ld -n -m elf_i386 -e _start -T "$@{链接布局文件}" -static \
        --no-ld-generated-unwind-info -o "$@{可执行文件}" \
        "$@{启动目标文件}" "$@{目标文件}" "$@{库文件}"
}
@{构建命令解释器}
