#ifndef _include_integer_types
#define _include_integer_types

typedef signed char signed_8_bit_integer;
typedef unsigned char unsigned_8_bit_integer;
typedef signed short signed_16_bit_integer;
typedef unsigned short unsigned_16_bit_integer;
typedef signed int signed_32_bit_integer;
typedef unsigned int unsigned_32_bit_integer;
typedef signed long long signed_64_bit_integer;
typedef unsigned long long unsigned_64_bit_integer;
typedef unsigned int pointer_sized_unsigned_integer;
typedef int pointer_sized_signed_integer;

#endif
