#include <प्रणाली/stat.h>
#include <प्रणाली/प्रणाली_पहचान.h>
#include <प्रणाली/syscall.h>

enum { SYS_संचिका_स्थिति = 106, SYS_कड़ी_की_अपनी_स्थिति_पाना = 107, SYS_खुली_संचिका_स्थिति_पाना = 108, SYS_प्रणाली_जानकारी_पाना = 122 };

int संचिका_स्थिति(const char *पथ, struct संचिका_स्थिति *स्थानांतरण_का_अस्थायी_भंडार)
{
    return (int)__syscall_result(
        __syscall6(SYS_संचिका_स्थिति, (long)पथ, (long)स्थानांतरण_का_अस्थायी_भंडार, 0, 0, 0, 0));
}

int कड़ी_की_अपनी_स्थिति_पाना(const char *पथ, struct संचिका_स्थिति *स्थानांतरण_का_अस्थायी_भंडार)
{
    return (int)__syscall_result(
        __syscall6(SYS_कड़ी_की_अपनी_स्थिति_पाना, (long)पथ, (long)स्थानांतरण_का_अस्थायी_भंडार, 0, 0, 0, 0));
}

int खुली_संचिका_स्थिति_पाना(int संचिका_विवरणक, struct संचिका_स्थिति *स्थानांतरण_का_अस्थायी_भंडार)
{
    return (int)__syscall_result(
        __syscall6(SYS_खुली_संचिका_स्थिति_पाना, संचिका_विवरणक, (long)स्थानांतरण_का_अस्थायी_भंडार, 0, 0, 0, 0));
}

int प्रणाली_जानकारी_पाना(struct utsname *प्रणाली_की_पहचान)
{
    return (int)__syscall_result(
        __syscall6(SYS_प्रणाली_जानकारी_पाना, (long)प्रणाली_की_पहचान, 0, 0, 0, 0, 0));
}
