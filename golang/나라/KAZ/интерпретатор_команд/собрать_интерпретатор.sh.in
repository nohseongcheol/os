#!/bin/sh
# @{...} denotes a native identifier placeholder, not standard shell syntax.
set -eu
@{исходный_файл}=$1
@{объектный_файл}=$2
@{исполняемый_файл}=$3
@{каталог_объявлений}=$4
@{стартовый_объект}=$5
@{файл_библиотеки}=$6
@{файл_компоновки}=$7

@{собрать_интерпретатор}() {
    gcc -m32 -std=c99 -ffreestanding -fno-pie -fno-pic -fno-stack-protector \
        -fno-builtin -Wall -Wextra -Werror -nostdinc \
        -I"$@{каталог_объявлений}" -c "$@{исходный_файл}" -o "$@{объектный_файл}"
    ld -n -m elf_i386 -e _start -T "$@{файл_компоновки}" -static \
        --no-ld-generated-unwind-info -o "$@{исполняемый_файл}" \
        "$@{стартовый_объект}" "$@{объектный_файл}" "$@{файл_библиотеки}"
}
@{собрать_интерпретатор}
