#!/bin/sh
# @{...} denotes a native identifier placeholder, not standard shell syntax.
set -eu
@{bronbestand}=$1
@{objectbestand}=$2
@{uitvoerbaar_bestand}=$3
@{declaratiemap}=$4
@{opstartobject}=$5
@{bibliotheekbestand}=$6
@{koppelbestand}=$7

@{opdrachtvertolker_bouwen}() {
    gcc -m32 -std=c99 -ffreestanding -fno-pie -fno-pic -fno-stack-protector \
        -fno-builtin -Wall -Wextra -Werror -nostdinc \
        -I"$@{declaratiemap}" -c "$@{bronbestand}" -o "$@{objectbestand}"
    ld -n -m elf_i386 -e _start -T "$@{koppelbestand}" -static \
        --no-ld-generated-unwind-info -o "$@{uitvoerbaar_bestand}" \
        "$@{opstartobject}" "$@{objectbestand}" "$@{bibliotheekbestand}"
}
@{opdrachtvertolker_bouwen}
