#!/bin/sh
# @{...} denotes a native identifier placeholder, not standard shell syntax.
set -eu
@{початковий_файл}=$1
@{об_єктний_файл}=$2
@{виконуваний_файл}=$3
@{каталог_оголошень}=$4
@{початковий_об_єкт}=$5
@{файл_бібліотеки}=$6
@{файл_компонування}=$7

@{зібрати_інтерпретатор}() {
    gcc -m32 -std=c99 -ffreestanding -fno-pie -fno-pic -fno-stack-protector \
        -fno-builtin -Wall -Wextra -Werror -nostdinc \
        -I"$@{каталог_оголошень}" -c "$@{початковий_файл}" -o "$@{об_єктний_файл}"
    ld -n -m elf_i386 -e _start -T "$@{файл_компонування}" -static \
        --no-ld-generated-unwind-info -o "$@{виконуваний_файл}" \
        "$@{початковий_об_єкт}" "$@{об_єктний_файл}" "$@{файл_бібліотеки}"
}
@{зібрати_інтерпретатор}
