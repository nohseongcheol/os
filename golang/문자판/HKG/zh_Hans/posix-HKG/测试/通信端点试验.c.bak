#include <通信地址/字节顺序.h>
#include <错误编号.h>
#include <系统/通信端点.h>
#include <输入输出与执行.h>

static unsigned int 取得文本长度(const char *受检数据)
{
    unsigned int 调用种类 = 0;
    while (受检数据[调用种类] != 0) 调用种类++;
    return 调用种类;
}

static void 写出报文(const char *受检数据) { (void)写入(标准输出编号, 受检数据, 取得文本长度(受检数据)); }

static void 报告结果(const char *系统资料, int 检查通过)
{
    写出报文(检查通过 ? "NTEST:PASS:" : "NTEST:FAIL:");
    写出报文(系统资料);
    写出报文("\n");
}

int main(void)
{
    struct 互联网络端点地址 响应端点地址 = {0};
    struct 互联网络端点地址 来源位置 = {0};
    地址长度类型 来源地址大小 = sizeof(来源位置);
    char 数据缓冲区域[8] = {0};
    int 响应端点 = 创建通信端点(互联网络地址族, 数据报端点, 用户数据报协议);
    int 请求端点 = 创建通信端点(互联网络地址族, 数据报端点, 0);

    报告结果("socket-server", 响应端点 >= 3);
    报告结果("socket-client", 请求端点 >= 3 && 请求端点 != 响应端点);
    响应端点地址.互联地址族 = 互联网络地址族;
    响应端点地址.通信端口编号 = 转为网络次序16位(32345);
    响应端点地址.互联地址内容.地址值 = 转为网络次序32位(本机回环地址);
    报告结果("bind", 绑定本地地址(响应端点, (const struct 通信端点地址 *)&响应端点地址,
                        sizeof(响应端点地址)) == 0);
    报告结果("connect", 连接对端(请求端点, (const struct 通信端点地址 *)&响应端点地址,
                              sizeof(响应端点地址)) == 0);
    报告结果("send", 发送(请求端点, "ping", 4, 0) == 4);
    报告结果("recvfrom", 接收并取得来源地址(响应端点, 数据缓冲区域, sizeof(数据缓冲区域), 0,
                                (struct 通信端点地址 *)&来源位置, &来源地址大小) == 4 &&
                       数据缓冲区域[0] == 'p' && 数据缓冲区域[3] == 'g' && 来源地址大小 == 16);
    错误编号 = 0;
    报告结果("empty-eagain", 接收(响应端点, 数据缓冲区域, sizeof(数据缓冲区域), 0) == -1 && 错误编号 == 错误暂时不可用);
    报告结果("getsockname", 取得本地端点地址(响应端点, (struct 通信端点地址 *)&来源位置,
                                      &来源地址大小) == 0 && 来源位置.通信端口编号 == 转为网络次序16位(32345));
    错误编号 = 0;
    报告结果("udp-listen-not-supported", 准备接收连接(响应端点, 1) == -1 && 错误编号 == 错误不支持操作);
    报告结果("close-client", 关闭(请求端点) == 0);
    报告结果("close-server", 关闭(响应端点) == 0);
    写出报文("NTEST:DONE\n");
    return 0;
}
