#include <errno.h>
#include <fcntl.h>
#include <அமைப்பு/stat.h>
#include <அமைப்பு/அமைப்பு_அடையாளம்.h>
#include <அமைப்பு/சேய்_காத்திருப்பு.h>
#include <unistd.h>

int posix_compile_test(void)
{
    char cwd[8];
    struct கோப்பு_நிலை st;
    struct utsname அமைப்பின்_அடையாளம்;
    int கோப்பு_விவரிப்பி = திற("/USER1", O_RDONLY);
    int copy = கோப்பு_விவரிப்பி >= 0 ? திறந்த_கோப்பின்_குறிப்பை_நகலெடு(கோப்பு_விவரிப்பி) : -1;
    if (copy >= 0) மூடு(copy);
    if (கோப்பு_விவரிப்பி >= 0) {
        திறந்த_கோப்பின்_நிலையைப்_பெறு(கோப்பு_விவரிப்பி, &st);
        கோப்பின்_படிப்பிடத்தை_நகர்த்து(கோப்பு_விவரிப்பி, 0, SEEK_SET);
        மூடு(கோப்பு_விவரிப்பி);
    }
    கோப்பு_நிலை("/", &st);
    அமைப்புத்_தகவலைப்_பெறு(&அமைப்பின்_அடையாளம்);
    பணி_அடைவின்_பாதையைப்_பெறு(cwd, sizeof(cwd));
    return errno + செயல்முறை_அடையாளத்தைப்_பெறு() + தாய்_செயல்முறை_அடையாளத்தைப்_பெறு();
}
