#include <にゅうしゅつりょくとじっこう.h>
#include <ぶんしょせいぎょ.h>
#include <あやまりばんごう.h>
#include <たいけい/ぶんしょじょうたい.h>
int かんすうしゅうのどうさをためす(void);

int main(void)
{
    char しりょうかんしょうりょういき[16];
    /* USER2 is the ELF fixture installed by the boot harness, not user data. */
    int ぶんしょきじゅつばんごう = ひらく("/USER2", よみとりせんようでひらく);
    struct ぶんしょじょうたい じょうたいしりょう;
    if (ぶんしょきじゅつばんごう < 0 || ひらいたぶんしょのじょうたいをえる(ぶんしょきじゅつばんごう, &じょうたいしりょう) < 0 || よむ(ぶんしょきじゅつばんごう, しりょうかんしょうりょういき, 4) != 4 ||
        (unsigned char)しりょうかんしょうりょういき[0] != 0x7f || しりょうかんしょうりょういき[1] != 'E' || しりょうかんしょうりょういき[2] != 'L' || しりょうかんしょうりょういき[3] != 'F' ||
        よみかきいちをうつす(ぶんしょきじゅつばんごう, 0, せんとうきじゅんいち) != 0 || とじる(ぶんしょきじゅつばんごう) < 0 || じっこうかていばんごうをえる() <= 0)
        goto しっぱいはんてい;
    あやまりばんごう = 0;
    if (よむ(-1, しりょうかんしょうりょういき, 1) != -1 || あやまりばんごう != あやまりきじゅつばんごうふせい)
        goto しっぱいはんてい;
    if (かんすうしゅうのどうさをためす() != 0)
        goto しっぱいはんてい;
    if (かく(ひょうじゅんしゅつりょくばんごう, "POSIX-NATIVE:PASS\n", 18) != 18)
        goto しっぱいはんてい;
    return 0;
しっぱいはんてい:
    かく(ひょうじゅんしゅつりょくばんごう, "POSIX-NATIVE:FAIL\n", 18);
    return 1;
}
