    unsigned long うけわたしあたい[5] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)せっていかいそう,
                          (unsigned long)せっていめい, (unsigned long)せっていち,
                          せっていちょう};
    return (int)つうしんたんてんをよびだす(つうしんたんてん_つうしんたんてんをせっていする, うけわたしあたい);
