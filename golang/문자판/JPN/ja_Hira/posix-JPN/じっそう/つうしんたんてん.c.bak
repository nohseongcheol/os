#include <つうしんばんち/はちけたぐみじゅんじょ.h>
#include <たいけい/たいけいよびだし.h>
#include <たいけい/つうしんたんてん.h>

enum { つうしんたんてんたいけいよびだしばんごう = 102 };
enum {
    つうしんたんてん_つうしんたんてんをつくる = 1, つうしんたんてん_きょくしょばんちをむすぶ = 2, つうしんたんてん_あいてたんてんにつなぐ = 3, つうしんたんてん_せつぞくようきゅうにそなえる = 4,
    つうしんたんてん_せつぞくようきゅうをうけいれる = 5, つうしんたんてん_きょくしょたんてんのばんちをえる = 6, つうしんたんてん_あいてたんてんのばんちをえる = 7,
    つうしんたんてん_おくる = 9, つうしんたんてん_うけとる = 10, つうしんたんてん_あてさきにおくる = 11, つうしんたんてん_そうしんもととともにうけとる = 12,
    つうしんたんてん_つうしんほうこうをとじる = 13, つうしんたんてん_つうしんたんてんをせっていする = 14
};

static long つうしんたんてんをよびだす(long つうしんよびだしばんごう, unsigned long *うけわたしひきすういちらん)
{
    return __syscall_result(
        __syscall6(つうしんたんてんたいけいよびだしばんごう, つうしんよびだしばんごう, (long)うけわたしひきすういちらん, 0, 0, 0, 0));
}

ふごうなし16にしんけたせいすう つうしんもうじゅんに16けたをかえる(ふごうなし16にしんけたせいすう あたい) { return (ふごうなし16にしんけたせいすう)((あたい << 8) | (あたい >> 8)); }
ふごうなし16にしんけたせいすう きかいじゅんに16けたをかえる(ふごうなし16にしんけたせいすう あたい) { return つうしんもうじゅんに16けたをかえる(あたい); }
ふごうなし32にしんけたせいすう つうしんもうじゅんに32けたをかえる(ふごうなし32にしんけたせいすう あたい)
{
    return ((あたい & 0x000000ffU) << 24) | ((あたい & 0x0000ff00U) << 8) |
           ((あたい & 0x00ff0000U) >> 8) | ((あたい & 0xff000000U) >> 24);
}
ふごうなし32にしんけたせいすう きかいじゅんに32けたをかえる(ふごうなし32にしんけたせいすう あたい) { return つうしんもうじゅんに32けたをかえる(あたい); }

int つうしんたんてんをつくる(int ばんちけいとう, int たんてんしゅるい, int つうしんきやく)
{
    unsigned long うけわたしあたい[3] = {(unsigned long)ばんちけいとう, (unsigned long)たんてんしゅるい, (unsigned long)つうしんきやく};
    return (int)つうしんたんてんをよびだす(つうしんたんてん_つうしんたんてんをつくる, うけわたしあたい);
}

int きょくしょばんちをむすぶ(int ぶんしょきじゅつばんごう, const struct つうしんたんてんばんち *ばんち, ばんちちょうがた ながさ)
{
    unsigned long うけわたしあたい[3] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)ばんち, ながさ};
    return (int)つうしんたんてんをよびだす(つうしんたんてん_きょくしょばんちをむすぶ, うけわたしあたい);
}

