{
    unsigned long うけわたしあたい[2] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)たいきじょうげん};
    return (int)つうしんたんてんをよびだす(つうしんたんてん_せつぞくようきゅうにそなえる, うけわたしあたい);
}

int せつぞくようきゅうをうけいれる(int ぶんしょきじゅつばんごう, struct つうしんたんてんばんち *ばんち, ばんちちょうがた *ながさ)
{
    unsigned long うけわたしあたい[3] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)ばんち, (unsigned long)ながさ};
    return (int)つうしんたんてんをよびだす(つうしんたんてん_せつぞくようきゅうをうけいれる, うけわたしあたい);
