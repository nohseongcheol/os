ふごうつきおおきさがた おくる(int ぶんしょきじゅつばんごう, const void *しりょうかんしょうりょういき, おおきさがた ながさ, int しょりしてい)
{
    unsigned long うけわたしあたい[4] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)しりょうかんしょうりょういき, ながさ, (unsigned long)しょりしてい};
    return (ふごうつきおおきさがた)つうしんたんてんをよびだす(つうしんたんてん_おくる, うけわたしあたい);
}

ふごうつきおおきさがた うけとる(int ぶんしょきじゅつばんごう, void *しりょうかんしょうりょういき, おおきさがた ながさ, int しょりしてい)
{
    unsigned long うけわたしあたい[4] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)しりょうかんしょうりょういき, ながさ, (unsigned long)しょりしてい};
    return (ふごうつきおおきさがた)つうしんたんてんをよびだす(つうしんたんてん_うけとる, うけわたしあたい);
}

ふごうつきおおきさがた あてさきにおくる(int ぶんしょきじゅつばんごう, const void *しりょうかんしょうりょういき, おおきさがた ながさ, int しょりしてい,
               const struct つうしんたんてんばんち *ばんち, ばんちちょうがた ばんちちょう)
{
    unsigned long うけわたしあたい[6] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)しりょうかんしょうりょういき, ながさ,
                          (unsigned long)しょりしてい, (unsigned long)ばんち, ばんちちょう};
    return (ふごうつきおおきさがた)つうしんたんてんをよびだす(つうしんたんてん_あてさきにおくる, うけわたしあたい);
}

ふごうつきおおきさがた そうしんもととともにうけとる(int ぶんしょきじゅつばんごう, void *しりょうかんしょうりょういき, おおきさがた ながさ, int しょりしてい,
                 struct つうしんたんてんばんち *ばんち, ばんちちょうがた *ばんちちょう)
{
    unsigned long うけわたしあたい[6] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)しりょうかんしょうりょういき, ながさ,
                          (unsigned long)しょりしてい, (unsigned long)ばんち,
                          (unsigned long)ばんちちょう};
    return (ふごうつきおおきさがた)つうしんたんてんをよびだす(つうしんたんてん_そうしんもととともにうけとる, うけわたしあたい);
}

int つうしんほうこうをとじる(int ぶんしょきじゅつばんごう, int とじるほうこう)
