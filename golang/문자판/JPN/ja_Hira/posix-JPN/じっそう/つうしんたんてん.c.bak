    unsigned long うけわたしあたい[2] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)とじるほうこう};
    return (int)つうしんたんてんをよびだす(つうしんたんてん_つうしんほうこうをとじる, うけわたしあたい);
