    unsigned long うけわたしあたい[3] = {(unsigned long)ぶんしょきじゅつばんごう, (unsigned long)ばんち, (unsigned long)ながさ};
    return (int)つうしんたんてんをよびだす(つうしんたんてん_あいてたんてんのばんちをえる, うけわたしあたい);
