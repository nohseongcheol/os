#include <アヤマリバンゴウ.h>
#include <ブンショセイギョ.h>
#include <ニュウシュツリョクトジッコウ.h>

static int モジレツイッチハンテイ(const char *ヒダリノアタイ, const char *ミギノアタイ)
{
    unsigned int コウノソエジ = 0;
    while (ヒダリノアタイ[コウノソエジ] != 0 && ミギノアタイ[コウノソエジ] != 0) {
        if (ヒダリノアタイ[コウノソエジ] != ミギノアタイ[コウノソエジ])
            return 0;
        コウノソエジ++;
    }
    return ヒダリノアタイ[コウノソエジ] == ミギノアタイ[コウノソエジ];
}

int main(int ヒキスウノカズ, char **ヒキスウイチラン, char **カンキョウイチラン)
{
    static const char ヨミコミチ[] = "PTEST:PASS:exec-image\n";
    static const char ヒキスウケンサセイコウ[] = "PTEST:PASS:exec-argv-envp\n";
    static const char ヒキスウケンサシッパイ[] = "PTEST:FAIL:exec-argv-envp\n";

    (void)カク(ヒョウジュンシュツリョクバンゴウ, ヨミコミチ, sizeof(ヨミコミチ) - 1);
    if (ヒキスウノカズ == 2 && ヒキスウイチラン != (char **)0 && カンキョウイチラン != (char **)0 &&
        ヒキスウイチラン[0] != (char *)0 && ヒキスウイチラン[1] != (char *)0 && ヒキスウイチラン[2] == (char *)0 &&
        カンキョウイチラン[0] != (char *)0 && カンキョウイチラン[1] == (char *)0 &&
        カンキョウヘンスウイチラン == カンキョウイチラン && モジレツイッチハンテイ(ヒキスウイチラン[0], "PXEXEC") &&
        モジレツイッチハンテイ(ヒキスウイチラン[1], "argument") && モジレツイッチハンテイ(カンキョウイチラン[0], "POSIX_TEST=1")) {
        (void)カク(ヒョウジュンシュツリョクバンゴウ, ヒキスウケンサセイコウ, sizeof(ヒキスウケンサセイコウ) - 1);
    } else {
        (void)カク(ヒョウジュンシュツリョクバンゴウ, ヒキスウケンサシッパイ, sizeof(ヒキスウケンサシッパイ) - 1);
        タダチニシュウリョウスル(38);
    }
    アヤマリバンゴウ = 0;
    if (ブンショヲセイギョスル(10, キジュツバンゴウヒョウシキシュトク) == -1 && アヤマリバンゴウ == アヤマリキジュツバンゴウフセイ) {
        static const char ジッコウチカンジヘイサセイコウ[] = "PTEST:PASS:cloexec\n";
        (void)カク(ヒョウジュンシュツリョクバンゴウ, ジッコウチカンジヘイサセイコウ, sizeof(ジッコウチカンジヘイサセイコウ) - 1);
        タダチニシュウリョウスル(37);
    }
    {
        static const char ジッコウチカンジヘイサシッパイ[] = "PTEST:FAIL:cloexec\n";
        (void)カク(ヒョウジュンシュツリョクバンゴウ, ジッコウチカンジヘイサシッパイ, sizeof(ジッコウチカンジヘイサシッパイ) - 1);
    }
    タダチニシュウリョウスル(39);
}
