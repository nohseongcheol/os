#include <アヤマリバンゴウ.h>
#include <ブンショセイギョ.h>
#include <タイケイ/ブンショジョウタイ.h>
#include <タイケイ/コノタイキ.h>
#include <ニュウシュツリョクトジッコウ.h>
#include <タイケイ/タイケイヨビダシ.h>

enum {
    タイケイヨビダシ_タダチニシュウリョウスル = 1,
    タイケイヨビダシ_ジッコウカテイヲブンキスル = 2,
    タイケイヨビダシ_ヨム = 3,
    タイケイヨビダシ_カク = 4,
    タイケイヨビダシ_トジル = 6,
    タイケイヨビダシ_ジッコウナイヨウヲオキカエル = 11,
    タイケイヨビダシ_サギョウモクロクヲカエル = 12,
    タイケイヨビダシ_ヨミカキイチヲウツス = 19,
    タイケイヨビダシ_ジッコウカテイバンゴウヲエル = 20,
    タイケイヨビダシ_リヨウシャバンゴウヲエル = 24,
    タイケイヨビダシ_リヨウケンゲンヲシラベル = 33,
    タイケイヨビダシ_スベテノキロクヲドウキスル = 36,
    タイケイヨビダシ_ヒライタブンショノサンショウヲフクセイスル = 41,
    タイケイヨビダシ_ドウテキキオクノシュウタンヲサダメル = 45,
    タイケイヨビダシ_ショゾククミバンゴウヲエル = 47,
    タイケイヨビダシ_ジッコウリヨウシャバンゴウヲエル = 49,
    タイケイヨビダシ_ジッコウショゾククミバンゴウヲエル = 50,
    タイケイヨビダシ_シテイバンゴウニブンショサンショウヲフクセイスル = 63,
    タイケイヨビダシ_オヤジッコウカテイバンゴウヲエル = 64,
    タイケイヨビダシ_ブンショノキロクヲドウキスル = 118,
    タイケイヨビダシ_サギョウモクロクノケイロヲエル = 183
};

#define ヒキスウナシタイケイヨビダシ(ヨビダシシュルイ) __syscall6((ヨビダシシュルイ), 0, 0, 0, 0, 0, 0)
#define ヒキスウヒトツタイケイヨビダシ(ヨビダシシュルイ,ウケワタシアタイ) __syscall6((ヨビダシシュルイ), (long)(ウケワタシアタイ), 0, 0, 0, 0, 0)
#define ヒキスウフタツタイケイヨビダシ(ヨビダシシュルイ,ウケワタシアタイ,ダイニチ) __syscall6((ヨビダシシュルイ), (long)(ウケワタシアタイ), (long)(ダイニチ), 0, 0, 0, 0)
#define ヒキスウミッツタイケイヨビダシ(ヨビダシシュルイ,ウケワタシアタイ,ダイニチ,ダイサンチ) __syscall6((ヨビダシシュルイ), (long)(ウケワタシアタイ), (long)(ダイニチ), (long)(ダイサンチ), 0, 0, 0)

void タダチニシュウリョウスル(int シュウリョウジョウタイ)
{
    ヒキスウヒトツタイケイヨビダシ(タイケイヨビダシ_タダチニシュウリョウスル, シュウリョウジョウタイ);
    for (;;) {
        __asm__ __volatile__("hlt");
    }
}

フゴウツキオオキサガタ ヨム(int ブンショキジュツバンゴウ, void *カンショウリョウイキ, オオキサガタ スウリョウ)
{
    return (フゴウツキオオキサガタ)__syscall_result(ヒキスウミッツタイケイヨビダシ(タイケイヨビダシ_ヨム, ブンショキジュツバンゴウ, カンショウリョウイキ, スウリョウ));
}

フゴウツキオオキサガタ カク(int ブンショキジュツバンゴウ, const void *カンショウリョウイキ, オオキサガタ スウリョウ)
{
    return (フゴウツキオオキサガタ)__syscall_result(ヒキスウミッツタイケイヨビダシ(タイケイヨビダシ_カク, ブンショキジュツバンゴウ, カンショウリョウイキ, スウリョウ));
}

int トジル(int ブンショキジュツバンゴウ)
{
    return (int)__syscall_result(ヒキスウヒトツタイケイヨビダシ(タイケイヨビダシ_トジル, ブンショキジュツバンゴウ));
}

ブンショイチガタ ヨミカキイチヲウツス(int ブンショキジュツバンゴウ, ブンショイチガタ イチサ, int イチキジュン)
{
    return (ブンショイチガタ)__syscall_result(ヒキスウミッツタイケイヨビダシ(タイケイヨビダシ_ヨミカキイチヲウツス, ブンショキジュツバンゴウ, イチサ, イチキジュン));
}

ジッコウカテイバンゴウガタ ジッコウカテイヲブンキスル(void)
{
    return (ジッコウカテイバンゴウガタ)__syscall_result(ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_ジッコウカテイヲブンキスル));
}

int ジッコウナイヨウヲオキカエル(const char *ケイロ, char *const ヒキスウイチラン[], char *const カンキョウイチラン[])
{
    return (int)__syscall_result(ヒキスウミッツタイケイヨビダシ(タイケイヨビダシ_ジッコウナイヨウヲオキカエル, ケイロ, ヒキスウイチラン, カンキョウイチラン));
}

ジッコウカテイバンゴウガタ ジッコウカテイバンゴウヲエル(void) { return (ジッコウカテイバンゴウガタ)ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_ジッコウカテイバンゴウヲエル); }
ジッコウカテイバンゴウガタ オヤジッコウカテイバンゴウヲエル(void) { return (ジッコウカテイバンゴウガタ)ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_オヤジッコウカテイバンゴウヲエル); }
リヨウシャバンゴウガタ リヨウシャバンゴウヲエル(void) { return (リヨウシャバンゴウガタ)ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_リヨウシャバンゴウヲエル); }
リヨウシャバンゴウガタ ジッコウリヨウシャバンゴウヲエル(void) { return (リヨウシャバンゴウガタ)ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_ジッコウリヨウシャバンゴウヲエル); }
ショゾククミバンゴウガタ ショゾククミバンゴウヲエル(void) { return (ショゾククミバンゴウガタ)ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_ショゾククミバンゴウヲエル); }
ショゾククミバンゴウガタ ジッコウショゾククミバンゴウヲエル(void) { return (ショゾククミバンゴウガタ)ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_ジッコウショゾククミバンゴウヲエル); }

int リヨウケンゲンヲシラベル(const char *ケイロ, int リヨウホウシキ)
{
    return (int)__syscall_result(ヒキスウフタツタイケイヨビダシ(タイケイヨビダシ_リヨウケンゲンヲシラベル, ケイロ, リヨウホウシキ));
}

int サギョウモクロクヲカエル(const char *ケイロ)
{
    return (int)__syscall_result(ヒキスウヒトツタイケイヨビダシ(タイケイヨビダシ_サギョウモクロクヲカエル, ケイロ));
}

char *サギョウモクロクノケイロヲエル(char *カンショウリョウイキ, オオキサガタ オオキサ)
{
    long ケッカ = __syscall_result(ヒキスウフタツタイケイヨビダシ(タイケイヨビダシ_サギョウモクロクノケイロヲエル, カンショウリョウイキ, オオキサ));
    return ケッカ < 0 ? (char *)0 : カンショウリョウイキ;
}

int ヒライタブンショノサンショウヲフクセイスル(int ブンショキジュツバンゴウ)
{
    return (int)__syscall_result(ヒキスウヒトツタイケイヨビダシ(タイケイヨビダシ_ヒライタブンショノサンショウヲフクセイスル, ブンショキジュツバンゴウ));
}

int シテイバンゴウニブンショサンショウヲフクセイスル(int キュウキジュツバンゴウ, int シンキジュツバンゴウ)
{
    return (int)__syscall_result(ヒキスウフタツタイケイヨビダシ(タイケイヨビダシ_シテイバンゴウニブンショサンショウヲフクセイスル, キュウキジュツバンゴウ, シンキジュツバンゴウ));
}

int ブンショノキロクヲドウキスル(int ブンショキジュツバンゴウ)
{
    return (int)__syscall_result(ヒキスウヒトツタイケイヨビダシ(タイケイヨビダシ_ブンショノキロクヲドウキスル, ブンショキジュツバンゴウ));
}

void スベテノキロクヲドウキスル(void)
{
    ヒキスウナシタイケイヨビダシ(タイケイヨビダシ_スベテノキロクヲドウキスル);
}

int タンマツカシラベル(int ブンショキジュツバンゴウ)
{
    struct ブンショジョウタイ ジョウタイシリョウ;
    if (ヒライタブンショノジョウタイヲエル(ブンショキジュツバンゴウ, &ジョウタイシリョウ) < 0)
        return 0;
    if (!モジソウチホウシキハンテイ(ジョウタイシリョウ.ブンショシュルイトケンゲン)) {
        アヤマリバンゴウ = アヤマリソウチフテキゴウソウサ;
        return 0;
    }
    return 1;
}

int ドウテキキオクノシュウタンヲサダメル(void *バンチ)
{
    long ケッカ = ヒキスウヒトツタイケイヨビダシ(タイケイヨビダシ_ドウテキキオクノシュウタンヲサダメル, バンチ);
    if (ケッカ != (long)バンチ) {
        アヤマリバンゴウ = アヤマリキオクブソク;
        return -1;
    }
    return 0;
}

void *ドウテキキオクノシュウタンヲウツス(int ゾウブン)
{
    long ゲンザイシュウタン = ヒキスウヒトツタイケイヨビダシ(タイケイヨビダシ_ドウテキキオクノシュウタンヲサダメル, 0);
    long ヨウキュウシュウタン = ゲンザイシュウタン + ゾウブン;
    if (ゾウブン != 0 && ドウテキキオクノシュウタンヲサダメル((void *)ヨウキュウシュウタン) < 0)
        return (void *)-1;
    return (void *)ゲンザイシュウタン;
}

ジッコウカテイバンゴウガタ シテイシタコヲマツ(ジッコウカテイバンゴウガタ ジッコウカテイバンゴウ, int *シュウリョウジョウタイ, int センタクジコウ)
{
    long ケッカ;
    do {
        ケッカ = ヒキスウミッツタイケイヨビダシ(7, ジッコウカテイバンゴウ, シュウリョウジョウタイ, センタクジコウ);
    } while (ケッカ == -アヤマリイチジリヨウフカ && (センタクジコウ & ミジュンビナラマタナイ) == 0);
    return (ジッコウカテイバンゴウガタ)__syscall_result(ケッカ);
}

ジッコウカテイバンゴウガタ コヲマツ(int *シュウリョウジョウタイ)
{
    return シテイシタコヲマツ(-1, シュウリョウジョウタイ, 0);
}
