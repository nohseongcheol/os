자바컴파일러 ?= javac
자바실행기 ?= java
موروثی_منبع_فایل := $(shell find موروثی_منبع -type f -name '*.java' | sort)
클래스위치 := سنجش/کلاس_مقدار
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 میزبان 한글검사 تمیز_ساخت ساخت_عکس

모두: 검사

$(완료표시): $(موروثی_منبع_فایل)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(موروثی_منبع_فایل)
	touch $(완료표시)

한글검사:
	@sh ابزارها/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) امارات_متحدهٔ_عربی.JAreOS.시험.전체시험

میزبان: 검사
	$(자바실행기) -cp $(클래스위치) امارات_متحدهٔ_عربی.JAreOS.میزبان.میزبان_راه_اندازی

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 موروثی_منبع/의 شئ_مقدار 기반 관리 هسته_مقدار 전체를 AOT 변환하는 대상은 아니다.
ساخت_عکس:
	$(MAKE) -C os iso

تمیز_ساخت:
	rm -rf سنجش
