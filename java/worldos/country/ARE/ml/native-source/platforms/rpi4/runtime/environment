#!/usr/bin/env python3
"""Describe/export a stopped portable home. Preserve ownership and xattrs."""
import argparse
import json
from pathlib import Path
import subprocess

p = argparse.ArgumentParser(description='jkoros ഉപയോക്താവ് 환경 സിസ്റ്റം_വിവരങ്ങള്/വിവര_സാങ്കേതികവിദ്യ_ഓഫ്_ലൈന് 내보내기')
p.add_argument('command', choices=['info', 'export'])
p.add_argument('--home', default='/home/user')
p.add_argument('--output')
a = p.parse_args()
home = Path(a.home).resolve()
marker = home / '.jkoros/system/base-id'
if not marker.is_file():
    p.error('jkoros ഉപയോക്താവ് 환경의 base-id가 없습니다')
if a.command == 'info':
    print(json.dumps({'home': str(home), 'base_id': marker.read_text().strip(),
                     'includes': ['files', 'user packages', 'system package overlay', 'settings'],
                     'requires': 'same system image, architecture, /home/user, UID 1000'}, ensure_ascii=False, indent=2))
else:
    if not a.output:
        p.error('--output 필요')
    mounts = Path('/proc/self/mountinfo').read_text()
    if 'upperdir=' + str(home / '.jkoros/system/upper') in mounts or ' /home/user ' in mounts and home == Path('/home/user'):
        p.error('നടപ്പാക്കുക_കമാന്_ഡ് 중인 환경은 내보낼 수 없습니다. പുറത്തുകടക്കൽ_പ്രോഗ്രാം 후 다른 Linux에서 실행하세요')
    output = Path(a.output).resolve()
    if output == home or home in output.parents:
        p.error('출력은 ഉപയോക്താവ് ഡയറക്ടറി_മൂല്യം 밖에 지정하세요')
    subprocess.run(['tar', '--xattrs', '--acls', '--numeric-owner', '--sparse',
                    '-cpf', str(output), '-C', str(home.parent), home.name], check=True)
