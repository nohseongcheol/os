자바컴파일러 ?= javac
자바실행기 ?= java
ঐতিহ্য_উত্স_ফাইলগুলি := $(shell find ঐতিহ্য_উত্স -type f -name '*.java' | sort)
클래스위치 := পরিমাপ/শ্রেণী_মান
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 হোস্ট 한글검사 পরিষ্কার_করুন_গঠন গঠন_ছবি

모두: 검사

$(완료표시): $(ঐতিহ্য_উত্স_ফাইলগুলি)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ঐতিহ্য_উত্স_ফাইলগুলি)
	touch $(완료표시)

한글검사:
	@sh সরঞ্জামগুলি/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) বাংলাদেশ.JBgdOS.시험.전체시험

হোস্ট: 검사
	$(자바실행기) -cp $(클래스위치) বাংলাদেশ.JBgdOS.হোস্ট.হোস্ট_বুট

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ঐতিহ্য_উত্স/의 বস্তু_মান 기반 관리 কারনেল_মান 전체를 AOT 변환하는 대상은 아니다.
গঠন_ছবি:
	$(MAKE) -C os iso

পরিষ্কার_করুন_গঠন:
	rm -rf পরিমাপ
