자바컴파일러 ?= javac
자바실행기 ?= java
наследен_източник_Файлове := $(shell find наследен_източник -type f -name '*.java' | sort)
클래스위치 := РЕЗУЛТАТ/Клас_стойност
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 хост 한글검사 Изостряне_компилация компилация_снимка

모두: 검사

$(완료표시): $(наследен_източник_Файлове)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(наследен_източник_Файлове)
	touch $(완료표시)

한글검사:
	@sh Инструменти/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) България.JBgrOS.시험.전체시험

хост: 검사
	$(자바실행기) -cp $(클래스위치) България.JBgrOS.хост.хост_начално_зареждане_на_ОС

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 наследен_източник/의 обект_стойност 기반 관리 ядро_стойност 전체를 AOT 변환하는 대상은 아니다.
компилация_снимка:
	$(MAKE) -C os iso

Изостряне_компилация:
	rm -rf РЕЗУЛТАТ
