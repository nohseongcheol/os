Javaコンパイラ ?= javac
Java実行器 ?= java
旧式ソースファイル群 := $(shell find 基幹ソース -type f -name '*.java' | sort)
クラス出力ディレクトリ := 結果/クラス値
完了状態標識 := $(クラス出力ディレクトリ)/.判定完了

.PHONY: 全体構築 検査項目 ホスト ハングル検査 清掃構築 イメージ構築

全体構築: 検査項目

$(完了状態標識): $(旧式ソースファイル群)
	mkdir -p $(クラス出力ディレクトリ)
	$(Javaコンパイラ) -encoding UTF-8 -Xlint:all -Werror -d $(クラス出力ディレクトリ) $(旧式ソースファイル群)
	touch $(完了状態標識)

ハングル検査:
	@sh 道具/識別子検査.sh

検査項目: ハングル検査 $(完了状態標識)
	$(Java実行器) -ea -cp $(クラス出力ディレクトリ) ブラジル.JBraOS.試験.全体試験

ホスト: 検査項目
	$(Java実行器) -cp $(クラス出力ディレクトリ) ブラジル.JBraOS.ホスト.ホスト始動

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 基幹ソース/의 オブジェクト値 基盤 관리 中核値 전체를 AOT 변환하는 대상은 아니다.
イメージ構築:
	$(MAKE) -C os iso

清掃構築:
	rm -rf 結果
