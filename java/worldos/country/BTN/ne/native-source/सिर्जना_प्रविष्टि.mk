자바컴파일러 ?= javac
자바실행기 ?= java
बिरासत_स्रोत_फाइलहरू := $(shell find बिरासत_स्रोत -type f -name '*.java' | sort)
클래스위치 := मापन/वर्ग_मान
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 होस्ट 한글검사 स्पष्ट_बनाउनुहोस् बनाउनुहोस्_छवि

모두: 검사

$(완료표시): $(बिरासत_स्रोत_फाइलहरू)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(बिरासत_स्रोत_फाइलहरू)
	touch $(완료표시)

한글검사:
	@sh उपकरणहरू/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) भुटान.JBtnOS.시험.전체시험

होस्ट: 검사
	$(자바실행기) -cp $(클래스위치) भुटान.JBtnOS.होस्ट.होस्ट_स्टार्टअप

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 बिरासत_स्रोत/의 वस्तु_मान 기반 관리 कर्णेल_मान 전체를 AOT 변환하는 대상은 아니다.
बनाउनुहोस्_छवि:
	$(MAKE) -C os iso

स्पष्ट_बनाउनुहोस्:
	rm -rf मापन
