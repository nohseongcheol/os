자바컴파일러 ?= javac
자바실행기 ?= java
застарілий_джерело_Файли := $(shell find застарілий_джерело -type f -name '*.java' | sort)
클래스위치 := результат/Клас_значення
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 хост 한글검사 Різкість_збірка збірка_фото

모두: 검사

$(완료표시): $(застарілий_джерело_Файли)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(застарілий_джерело_Файли)
	touch $(완료표시)

한글검사:
	@sh інструменти/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Канада.JCanOS.випробування.전체시험

хост: 검사
	$(자바실행기) -cp $(클래스위치) Канада.JCanOS.хост.хост_завантаження

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 застарілий_джерело/의 об_єкт_значення 기반 관리 ядро_значення 전체를 AOT 변환하는 대상은 아니다.
збірка_фото:
	$(MAKE) -C os iso

Різкість_збірка:
	rm -rf результат
