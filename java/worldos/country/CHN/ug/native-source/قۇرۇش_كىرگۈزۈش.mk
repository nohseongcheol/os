자바컴파일러 ?= javac
자바실행기 ?= java
كونا_مەنبە_ھۆججەت := $(shell find كونا_مەنبە -type f -name '*.java' | sort)
클래스위치 := ئۆلچەم/تۈركۈم_قىممىتى
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 باقار 한글검사 تازىلاش_پاكىز_نۇسخا نۇسخا_رەسىم

모두: 검사

$(완료표시): $(كونا_مەنبە_ھۆججەت)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(كونا_مەنبە_ھۆججەت)
	touch $(완료표시)

한글검사:
	@sh قوراللار/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) جۇڭگو.JChnOS.시험.전체시험

باقار: 검사
	$(자바실행기) -cp $(클래스위치) جۇڭگو.JChnOS.باقار.باقار_قوزغىتىش

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 كونا_مەنبە/의 ئوبيېكت_قىممىتى 기반 관리 يادرو_قىممىتى 전체를 AOT 변환하는 대상은 아니다.
نۇسخا_رەسىم:
	$(MAKE) -C os iso

تازىلاش_پاكىز_نۇسخا:
	rm -rf ئۆلچەم
