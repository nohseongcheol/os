자바컴파일러 ?= javac
자바실행기 ?= java
ժառանգված_աղբյուր_Նիշքեր := $(shell find ժառանգված_աղբյուր -type f -name '*.java' | sort)
클래스위치 := չափ/դաս_արժեք
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 հոստ 한글검사 Մաքուր_կառուցել կառուցել_նկար

모두: 검사

$(완료표시): $(ժառանգված_աղբյուր_Նիշքեր)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ժառանգված_աղբյուր_Նիշքեր)
	touch $(완료표시)

한글검사:
	@sh Գործիքներ/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Կիպրոս.JCypOS.시험.전체시험

հոստ: 검사
	$(자바실행기) -cp $(클래스위치) Կիպրոս.JCypOS.հոստ.հոստ_մեկնարկում

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ժառանգված_աղբյուր/의 առարկա_արժեք 기반 관리 միջուկ_արժեք 전체를 AOT 변환하는 대상은 아니다.
կառուցել_նկար:
	$(MAKE) -C os iso

Մաքուր_կառուցել:
	rm -rf չափ
