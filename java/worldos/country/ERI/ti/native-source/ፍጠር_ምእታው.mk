자바컴파일러 ?= javac
자바실행기 ?= java
ውርሻ_ምንጪ_ፋይላት := $(shell find ውርሻ_ምንጪ -type f -name '*.java' | sort)
클래스위치 := 결과/ክፍሊ_ዋጋ
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 አዐንግድ 한글검사 정리 ህነጽ_ምስሊ

모두: 검사

$(완료표시): $(ውርሻ_ምንጪ_ፋይላት)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ውርሻ_ምንጪ_ፋይላት)
	touch $(완료표시)

한글검사:
	@sh መሳርሒታት/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) ኤርትራ.JEriOS.시험.전체시험

አዐንግድ: 검사
	$(자바실행기) -cp $(클래스위치) ኤርትራ.JEriOS.አዐንግድ.አዐንግድ_ምጅማር

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ውርሻ_ምንጪ/의 ነገር_ዋጋ 기반 관리 ፍረ_ዋጋ 전체를 AOT 변환하는 대상은 아니다.
ህነጽ_ምስሊ:
	$(MAKE) -C os iso

정리:
	rm -rf 결과
