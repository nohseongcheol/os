자바컴파일러 ?= javac
자바실행기 ?= java
लिगेसी_स्रोत_फ़ाइलें := $(shell find लिगेसी_स्रोत -type f -name '*.java' | sort)
클래스위치 := परिणाम/कक्षा_मान
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 आयोजक 한글검사 साफ_बिल्ड बिल्ड_छवि

모두: 검사

$(완료표시): $(लिगेसी_स्रोत_फ़ाइलें)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(लिगेसी_स्रोत_फ़ाइलें)
	touch $(완료표시)

한글검사:
	@sh उपकरण/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) फ़िजी.JFjiOS.시험.전체시험

आयोजक: 검사
	$(자바실행기) -cp $(클래스위치) फ़िजी.JFjiOS.आयोजक.आयोजक_स्टार्टअप

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 लिगेसी_स्रोत/의 ऑब्जेक्ट_मान 기반 관리 कर्नेल_मान 전체를 AOT 변환하는 대상은 아니다.
बिल्ड_छवि:
	$(MAKE) -C os iso

साफ_बिल्ड:
	rm -rf परिणाम
