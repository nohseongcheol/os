자바컴파일러 ?= javac
자바실행기 ?= java
ورثہ_ماخذ_فائلیں := $(shell find ورثہ_ماخذ -type f -name '*.java' | sort)
클래스위치 := پیمائش/صنف_قدر
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 میزبان 한글검사 صاف_بلڈ بلڈ_نقش

모두: 검사

$(완료표시): $(ورثہ_ماخذ_فائلیں)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ورثہ_ماخذ_فائلیں)
	touch $(완료표시)

한글검사:
	@sh ٹولز/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) سلطنت_متحدہ.JGbrOS.시험.전체시험

میزبان: 검사
	$(자바실행기) -cp $(클래스위치) سلطنت_متحدہ.JGbrOS.میزبان.میزبان_بوٹ_کریں

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ورثہ_ماخذ/의 آبجیکٹ_قدر 기반 관리 کرنیل_قدر 전체를 AOT 변환하는 대상은 아니다.
بلڈ_نقش:
	$(MAKE) -C os iso

صاف_بلڈ:
	rm -rf پیمائش
