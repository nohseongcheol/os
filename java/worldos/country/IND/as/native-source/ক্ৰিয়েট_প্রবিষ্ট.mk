자바컴파일러 ?= javac
자바실행기 ?= java
লীগেছি_উৎস_ফাইলসমূহ := $(shell find লীগেছি_উৎস -type f -name '*.java' | sort)
클래스위치 := পৰিমাপ/শ্ৰেণী_মান
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 হ_ষ্ট 한글검사 ক্লিন_বিল্ড বিল্ড_ছবি

모두: 검사

$(완료표시): $(লীগেছি_উৎস_ফাইলসমূহ)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(লীগেছি_উৎস_ফাইলসমূহ)
	touch $(완료표시)

한글검사:
	@sh সঁজুলিসমূহ/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) ভাৰত.JIndOS.시험.전체시험

হ_ষ্ট: 검사
	$(자바실행기) -cp $(클래스위치) ভাৰত.JIndOS.হ_ষ্ট.হ_ষ্ট_বুট

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 লীগেছি_উৎস/의 অবজেক্ট_মান 기반 관리 কাৰ্ণেল_মান 전체를 AOT 변환하는 대상은 아니다.
বিল্ড_ছবি:
	$(MAKE) -C os iso

ক্লিন_বিল্ড:
	rm -rf পৰিমাপ
