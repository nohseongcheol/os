자바컴파일러 ?= javac
자바실행기 ?= java
લેગસી_સ્રોત_ફાઇલો := $(shell find લેગસી_સ્રોત -type f -name '*.java' | sort)
클래스위치 := પરિમાણ/વર્ગ_મૂલ્ય
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 હોસ્ટ 한글검사 નિર્મળ_બિલ્ડ બિલ્ડ_છબી

모두: 검사

$(완료표시): $(લેગસી_સ્રોત_ફાઇલો)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(લેગસી_સ્રોત_ફાઇલો)
	touch $(완료표시)

한글검사:
	@sh ઉપકરણો/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) ભારત.JIndOS.시험.전체시험

હોસ્ટ: 검사
	$(자바실행기) -cp $(클래스위치) ભારત.JIndOS.હોસ્ટ.હોસ્ટ_બૂટ

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 લેગસી_સ્રોત/의 ઑબ્જેક્ટ_મૂલ્ય 기반 관리 કર્નેલ_મૂલ્ય 전체를 AOT 변환하는 대상은 아니다.
બિલ્ડ_છબી:
	$(MAKE) -C os iso

નિર્મળ_બિલ્ડ:
	rm -rf પરિમાણ
