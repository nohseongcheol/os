자바컴파일러 ?= javac
자바실행기 ?= java
ಲೆಗಸಿ_ಮೂಲ_ಫೈಲ್_ಗಳು := $(shell find ಲೆಗಸಿ_ಮೂಲ -type f -name '*.java' | sort)
클래스위치 := ಮಾಪನ/ವರ್ಗ_ಮೌಲ್ಯ_55654bf1
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 ಹೋಸ್ಟ್ 한글검사 ಸ್ವಚ್ಛ_ಬಿಲ್ಡ್ ಬಿಲ್ಡ್_ಇಮೇಜ್

모두: 검사

$(완료표시): $(ಲೆಗಸಿ_ಮೂಲ_ಫೈಲ್_ಗಳು)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ಲೆಗಸಿ_ಮೂಲ_ಫೈಲ್_ಗಳು)
	touch $(완료표시)

한글검사:
	@sh ಪರಿಕರಗಳು/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) ಭಾರತ.JIndOS.시험.전체시험

ಹೋಸ್ಟ್: 검사
	$(자바실행기) -cp $(클래스위치) ಭಾರತ.JIndOS.ಹೋಸ್ಟ್.ಹೋಸ್ಟ್_ಬೂಟ್

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ಲೆಗಸಿ_ಮೂಲ/의 ಆಬ್ಜೆಕ್ಟ್_ಮೌಲ್ಯ 기반 관리 ಕರ್ನಲ್_ಮೌಲ್ಯ 전체를 AOT 변환하는 대상은 아니다.
ಬಿಲ್ಡ್_ಇಮೇಜ್:
	$(MAKE) -C os iso

ಸ್ವಚ್ಛ_ಬಿಲ್ಡ್:
	rm -rf ಮಾಪನ
