자바컴파일러 ?= javac
자바실행기 ?= java
लिगसी_स्त्रोत_फायली := $(shell find लिगसी_स्त्रोत -type f -name '*.java' | sort)
클래스위치 := मेजप/वर्ग_मोल_55654bf1
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 येजमान 한글검사 नितळ_दाळचे दाळचे_IMAGE

모두: 검사

$(완료표시): $(लिगसी_स्त्रोत_फायली)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(लिगसी_स्त्रोत_फायली)
	touch $(완료표시)

한글검사:
	@sh साधनां/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) भारत.JIndOS.시험.전체시험

येजमान: 검사
	$(자바실행기) -cp $(클래스위치) भारत.JIndOS.येजमान.येजमान_स्टार्टअप

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 लिगसी_स्त्रोत/의 ऑब्जॅक्ट_मोल 기반 관리 कर्नेल_मोल 전체를 AOT 변환하는 대상은 아니다.
दाळचे_IMAGE:
	$(MAKE) -C os iso

नितळ_दाळचे:
	rm -rf मेजप
