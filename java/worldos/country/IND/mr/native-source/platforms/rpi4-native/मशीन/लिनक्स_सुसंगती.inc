/* Deliberate opt-in, limited Linux AArch64 syscall ABI. No Linux kernel/libc.
 * Included after native_system_call so the same pointer/FD checks are reused.
 */
static intptr_t लिनक्स_सिस्टम_कॉल(प्रयोक्ता_फ्रेम *संचिका_प्रविष्टी) {
    प्रयोक्ता_फ्रेम भाषांतरित = *संचिका_प्रविष्टी;
    uintptr_t संख्यात्मक_मूल्य = संचिका_प्रविष्टी->रजिस्टर_डेटा[8];
    switch (संख्यात्मक_मूल्य) {
    case 63: भाषांतरित.रजिस्टर_डेटा[8] = 2; break;   /* read */
    case 64: भाषांतरित.रजिस्टर_डेटा[8] = 1; break;   /* write */
    case 57: भाषांतरित.रजिस्टर_डेटा[8] = 4; break;   /* close */
    case 62: भाषांतरित.रजिस्टर_डेटा[8] = 5; break;   /* lseek */
    case 46: भाषांतरित.रजिस्टर_डेटा[8] = 10; break;  /* ftruncate */
    case 82: भाषांतरित.रजिस्टर_डेटा[8] = 12; break;  /* fsync */
    case 56:                              /* openat */
    case 35: {                            /* unlinkat, ordinary files */
        char मार्ग[65]; int परतलेले_मूल्य = इन्स्टन्स_पथ(संचिका_प्रविष्टी->रजिस्टर_डेटा[1], मार्ग); if (परतलेले_मूल्य) return परतलेले_मूल्य;
        if ((int)संचिका_प्रविष्टी->रजिस्टर_डेटा[0] != -100 && मार्ग[0] != '/') return -95;
        if (संख्यात्मक_मूल्य == 35 && संचिका_प्रविष्टी->रजिस्टर_डेटा[2]) return -95;
        if (संख्यात्मक_मूल्य == 56 && (संचिका_प्रविष्टी->रजिस्टर_डेटा[2] & ~(0x7fful | 0x80000ul))) return -95;
        भाषांतरित.रजिस्टर_डेटा[8] = संख्यात्मक_मूल्य == 56 ? 3 : 11;
        भाषांतरित.रजिस्टर_डेटा[0] = संचिका_प्रविष्टी->रजिस्टर_डेटा[1];
        भाषांतरित.रजिस्टर_डेटा[1] = संचिका_प्रविष्टी->रजिस्टर_डेटा[2] & ~0x80000ul; /* O_CLOEXEC: no execve yet */
        भाषांतरित.रजिस्टर_डेटा[2] = संचिका_प्रविष्टी->रजिस्टर_डेटा[3];
        break;
    }
    case 214: {                           /* brk: failure returns old break */
        uintptr_t मागील = गतिमानस्मृतिराशी_शेवट_करा;
        भाषांतरित.रजिस्टर_डेटा[8] = 8;
        intptr_t परतलेले_मूल्य = स्वकीय_सिस्टम_कॉल(&भाषांतरित);
        return परतलेले_मूल्य < 0 ? (intptr_t)मागील : परतलेले_मूल्य;
    }
    case 113: {                           /* clock_gettime, MONOTONIC only */
        if (संचिका_प्रविष्टी->रजिस्टर_डेटा[0] != 1) return -22;
        if (!प्रयोक्ता_व्याप्ती(संचिका_प्रविष्टी->रजिस्टर_डेटा[1], 16, 1)) return -14;
        uint64_t मिलिसेकंद = बोर्ड_मिलिसेकंद(), मूल्य[2] = {मिलिसेकंद / 1000, (मिलिसेकंद % 1000) * 1000000};
        memcpy((void *)संचिका_प्रविष्टी->रजिस्टर_डेटा[1], मूल्य, sizeof(मूल्य)); return 0;
    }
    case 172:                             /* getpid */
    case 178: return मालक_ऑब्जेक्ट + 1;            /* gettid: one native thread */
    default: return -38;                   /* ENOSYS; never use native numbers */
    }
    return स्वकीय_सिस्टम_कॉल(&भाषांतरित);
}

static uintptr_t लिनक्स_प्रारंभ_स्टॅक(uintptr_t प्रविष्टी_गुण) {
    uintptr_t वरचे_प्रविष्टी = प्रयोक्ता_शेवट_करा, पत्ते[8];
    for (unsigned क्रमांक_अनुक्रमणिका = 0; क्रमांक_अनुक्रमणिका < अग्रेषित_वितर्क_संख्या; क्रमांक_अनुक्रमणिका++) {
        unsigned आयटम_संख्या = अग्रेषित_वितर्क_लांबी[क्रमांक_अनुक्रमणिका] + 1;
        वरचे_प्रविष्टी -= आयटम_संख्या; memcpy((void *)वरचे_प्रविष्टी, अग्रेषित_वितर्क[क्रमांक_अनुक्रमणिका], आयटम_संख्या); पत्ते[क्रमांक_अनुक्रमणिका] = वरचे_प्रविष्टी;
    }
    /* argc, argv[], NULL, empty envp, AT_PAGESZ, AT_ENTRY, AT_NULL. */
    uintptr_t स्टॅक_संग्रह = (वरचे_प्रविष्टी - (अग्रेषित_वितर्क_संख्या + 9) * sizeof(uint64_t)) & ~15ul;
    uint64_t *डेटा_स्थान = (uint64_t *)स्टॅक_संग्रह;
    *डेटा_स्थान++ = अग्रेषित_वितर्क_संख्या;
    for (unsigned क्रमांक_अनुक्रमणिका = 0; क्रमांक_अनुक्रमणिका < अग्रेषित_वितर्क_संख्या; क्रमांक_अनुक्रमणिका++) *डेटा_स्थान++ = पत्ते[क्रमांक_अनुक्रमणिका];
    *डेटा_स्थान++ = 0; *डेटा_स्थान++ = 0;
    *डेटा_स्थान++ = 6; *डेटा_स्थान++ = पृष्ठ_आकार;
    *डेटा_स्थान++ = 9; *डेटा_स्थान++ = प्रविष्टी_गुण;
    *डेटा_स्थान++ = 0; *डेटा_स्थान++ = 0;
    return स्टॅक_संग्रह;
}
