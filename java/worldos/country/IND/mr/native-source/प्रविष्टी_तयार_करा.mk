जावा_संकलक ?= javac
जावा_चालक ?= java
लेगसी_स्रोत_संचिका := $(shell find लेगसी_स्रोत -type f -name '*.java' | sort)
वर्ग_प्रदान_निर्देशिका := मोजमाप/वर्ग_मूल्य
पूर्तता_खूण := $(वर्ग_प्रदान_निर्देशिका)/.आहे_पूर्ण

.PHONY: सर्व_बांधणी पडताळण्या होस्ट हांगुल_तपासा सुबक_बांधणी चित्र_बांधणी

सर्व_बांधणी: पडताळण्या

$(पूर्तता_खूण): $(लेगसी_स्रोत_संचिका)
	mkdir -p $(वर्ग_प्रदान_निर्देशिका)
	$(जावा_संकलक) -encoding UTF-8 -Xlint:all -Werror -d $(वर्ग_प्रदान_निर्देशिका) $(लेगसी_स्रोत_संचिका)
	touch $(पूर्तता_खूण)

हांगुल_तपासा:
	@sh साधने/हांगुल_नावे_तपासा.sh

पडताळण्या: हांगुल_तपासा $(पूर्तता_खूण)
	$(जावा_चालक) -ea -cp $(वर्ग_प्रदान_निर्देशिका) भारत.JIndOS.चाचण्या.सर्व_चाचणी

होस्ट: पडताळण्या
	$(जावा_चालक) -cp $(वर्ग_प्रदान_निर्देशिका) भारत.JIndOS.होस्ट.होस्ट_बूट

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 लेगसी_स्रोत/의 ऑब्जेक्ट_मूल्य पाया 관리 गाभा_मूल्य 전체를 AOT 변환하는 대상은 아니다.
चित्र_बांधणी:
	$(MAKE) -C os iso

सुबक_बांधणी:
	rm -rf मोजमाप
