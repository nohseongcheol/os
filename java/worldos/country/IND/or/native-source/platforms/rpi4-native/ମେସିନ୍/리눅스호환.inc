/* Deliberate opt-in, limited Linux AArch64 syscall ABI. No Linux kernel/libc.
 * Included after native_system_call so the same pointer/FD checks are reused.
 */
static intptr_t 리눅스체계호출(ଉପଭୋକ୍ତା_ଫ୍ରେମ୍ *ଫାଇଲ୍_ଏଣ୍ଟ୍ରି) {
    ଉପଭୋକ୍ତା_ଫ୍ରେମ୍ 변환값 = *ଫାଇଲ୍_ଏଣ୍ଟ୍ରି;
    uintptr_t 수치 = ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8];
    switch (수치) {
    case 63: 변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 2; break;   /* read */
    case 64: 변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 1; break;   /* write */
    case 57: 변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 4; break;   /* close */
    case 62: 변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 5; break;   /* lseek */
    case 46: 변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 10; break;  /* ftruncate */
    case 82: 변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 12; break;  /* fsync */
    case 56:                              /* openat */
    case 35: {                            /* unlinkat, ordinary files */
        char ପଥ[65]; int 반환값 = କପି_ପଥ(ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[1], ପଥ); if (반환값) return 반환값;
        if ((int)ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[0] != -100 && ପଥ[0] != '/') return -95;
        if (수치 == 35 && ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[2]) return -95;
        if (수치 == 56 && (ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[2] & ~(0x7fful | 0x80000ul))) return -95;
        변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 수치 == 56 ? 3 : 11;
        변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[0] = ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[1];
        변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[1] = ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[2] & ~0x80000ul; /* O_CLOEXEC: no execve yet */
        변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[2] = ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[3];
        break;
    }
    case 214: {                           /* brk: failure returns old break */
        uintptr_t 이전항목 = 동적기억끝;
        변환값.ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[8] = 8;
        intptr_t 반환값 = 자체체계호출(&변환값);
        return 반환값 < 0 ? (intptr_t)이전항목 : 반환값;
    }
    case 113: {                           /* clock_gettime, MONOTONIC only */
        if (ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[0] != 1) return -22;
        if (!사용자범위(ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[1], 16, 1)) return -14;
        uint64_t 밀리초 = 보드밀리초(), ମୂଲ୍ୟ[2] = {밀리초 / 1000, (밀리초 % 1000) * 1000000};
        memcpy((void *)ଫାଇଲ୍_ଏଣ୍ଟ୍ରି->ପଞ୍ଜିକରଣ_କରନ୍ତୁ_ଡାଟା[1], ମୂଲ୍ୟ, sizeof(ମୂଲ୍ୟ)); return 0;
    }
    case 172:                             /* getpid */
    case 178: return ମାଲିକ_ଅବଜେକ୍ଟ + 1;            /* gettid: one native thread */
    default: return -38;                   /* ENOSYS; never use native numbers */
    }
    return 자체체계호출(&변환값);
}

static uintptr_t 리눅스시작쌓임(uintptr_t ଏଣ୍ଟ୍ରି_ପଏଣ୍ଟ୍) {
    uintptr_t 맨위 = ଉପଭୋକ୍ତା_ଶେଷ_କରନ୍ତୁ, 주소목록[8];
    for (unsigned 순번 = 0; 순번 < 전달인수개수; 순번++) {
        unsigned 개수 = 전달인수길이[순번] + 1;
        맨위 -= 개수; memcpy((void *)맨위, 전달인수[순번], 개수); 주소목록[순번] = 맨위;
    }
    /* argc, argv[], NULL, empty envp, AT_PAGESZ, AT_ENTRY, AT_NULL. */
    uintptr_t ଗଦା_ଷ୍ଟୋରେଜ୍ = (맨위 - (전달인수개수 + 9) * sizeof(uint64_t)) & ~15ul;
    uint64_t *ଡାଟା_ସ୍ଥିତି = (uint64_t *)ଗଦା_ଷ୍ଟୋରେଜ୍;
    *ଡାଟା_ସ୍ଥିତି++ = 전달인수개수;
    for (unsigned 순번 = 0; 순번 < 전달인수개수; 순번++) *ଡାଟା_ସ୍ଥିତି++ = 주소목록[순번];
    *ଡାଟା_ସ୍ଥିତି++ = 0; *ଡାଟା_ସ୍ଥିତି++ = 0;
    *ଡାଟା_ସ୍ଥିତି++ = 6; *ଡାଟା_ସ୍ଥିତି++ = ପୃଷ୍ଠା_ଆକାର;
    *ଡାଟା_ସ୍ଥିତି++ = 9; *ଡାଟା_ସ୍ଥିତି++ = ଏଣ୍ଟ୍ରି_ପଏଣ୍ଟ୍;
    *ଡାଟା_ସ୍ଥିତି++ = 0; *ଡାଟା_ସ୍ଥିତି++ = 0;
    return ଗଦା_ଷ୍ଟୋରେଜ୍;
}
