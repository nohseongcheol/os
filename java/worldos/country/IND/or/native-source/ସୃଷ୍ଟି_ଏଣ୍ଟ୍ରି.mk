자바컴파일러 ?= javac
자바실행기 ?= java
ଲିଗାସୀ_ଉତ୍ସ_ଫାଇଲ୍_ଗୁଡିକ := $(shell find ଲିଗାସୀ_ଉତ୍ସ -type f -name '*.java' | sort)
클래스위치 := ମାପ/ଶ୍ରେଣୀ_ମୂଲ୍ୟ_55654bf1
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 ଆୟୋଜକ 한글검사 କ୍ଲିନ୍_ବିଲ୍ଡ୍ ବିଲ୍ଡ୍_ଚିତ୍ର

모두: 검사

$(완료표시): $(ଲିଗାସୀ_ଉତ୍ସ_ଫାଇଲ୍_ଗୁଡିକ)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ଲିଗାସୀ_ଉତ୍ସ_ଫାଇଲ୍_ଗୁଡିକ)
	touch $(완료표시)

한글검사:
	@sh ଉପକରଣସମୂହ/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) ଭାରତ.JIndOS.시험.전체시험

ଆୟୋଜକ: 검사
	$(자바실행기) -cp $(클래스위치) ଭାରତ.JIndOS.ଆୟୋଜକ.ଆୟୋଜକ_ଷ୍ଟାର୍ଟଅପ୍

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ଲିଗାସୀ_ଉତ୍ସ/의 ଅବଜେକ୍ଟ_ମୂଲ୍ୟ 기반 관리 କେନ୍ଦ୍ରିକ_ମୂଲ୍ୟ 전체를 AOT 변환하는 대상은 아니다.
ବିଲ୍ଡ୍_ଚିତ୍ର:
	$(MAKE) -C os iso

କ୍ଲିନ୍_ବିଲ୍ଡ୍:
	rm -rf ମାପ
