자바컴파일러 ?= javac
자바실행기 ?= java
ميراث_ماخذ_فائلون := $(shell find ميراث_ماخذ -type f -name '*.java' | sort)
클래스위치 := 결과/درجو_قدر
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 مهمان 한글검사 ڪلين_گڏ_ڪريو گڏ_ڪريو_نقش

모두: 검사

$(완료표시): $(ميراث_ماخذ_فائلون)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ميراث_ماخذ_فائلون)
	touch $(완료표시)

한글검사:
	@sh اوزار/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) ڀارت.JIndOS.시험.전체시험

مهمان: 검사
	$(자바실행기) -cp $(클래스위치) ڀارت.JIndOS.مهمان.مهمان_شروعات

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ميراث_ماخذ/의 عنصر_قدر_2ed200e9 기반 관리 ڪرنل_قدر 전체를 AOT 변환하는 대상은 아니다.
گڏ_ڪريو_نقش:
	$(MAKE) -C os iso

ڪلين_گڏ_ڪريو:
	rm -rf 결과
