자바컴파일러 ?= javac
자바실행기 ?= java
లెగసి_మూలం_ఫైల్_లు := $(shell find లెగసి_మూలం -type f -name '*.java' | sort)
클래스위치 := ప్రమాణం/తరగతి_మూల్యం
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 హోస్ట్ 한글검사 పరిశుభ్రమైన_బిల్డ్ బిల్డ్_చిత్రం

모두: 검사

$(완료표시): $(లెగసి_మూలం_ఫైల్_లు)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(లెగసి_మూలం_ఫైల్_లు)
	touch $(완료표시)

한글검사:
	@sh ఉపకరణాలు/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) భారతదేశం.JIndOS.시험.전체시험

హోస్ట్: 검사
	$(자바실행기) -cp $(클래스위치) భారతదేశం.JIndOS.హోస్ట్.హోస్ట్_బూట్

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 లెగసి_మూలం/의 అంశం_మూల్యం 기반 관리 కెర్నల్_మూల్యం 전체를 AOT 변환하는 대상은 아니다.
బిల్డ్_చిత్రం:
	$(MAKE) -C os iso

పరిశుభ్రమైన_బిల్డ్:
	rm -rf ప్రమాణం
