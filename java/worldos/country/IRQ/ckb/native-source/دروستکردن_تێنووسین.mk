자바컴파일러 ?= javac
자바실행기 ?= java
جێماو_ژێدەر_فایله_کان := $(shell find جێماو_ژێدەر -type f -name '*.java' | sort)
클래스위치 := 결과/کلاس_نرخ
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 جێدەر 한글검사 정리 دروستکراو_وێنە

모두: 검사

$(완료표시): $(جێماو_ژێدەر_فایله_کان)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(جێماو_ژێدەر_فایله_کان)
	touch $(완료표시)

한글검사:
	@sh ئامرازەکان/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) عێراق.JIrqOS.시험.전체시험

جێدەر: 검사
	$(자바실행기) -cp $(클래스위치) عێراق.JIrqOS.جێدەر.جێدەر_دەسپێک

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 جێماو_ژێدەر/의 شت_نرخ 기반 관리 کوورەک_نرخ 전체를 AOT 변환하는 대상은 아니다.
دروستکراو_وێنە:
	$(MAKE) -C os iso

정리:
	rm -rf 결과
