자바컴파일러 ?= javac
자바실행기 ?= java
דור_קודם_מקור_קבצים := $(shell find דור_קודם_מקור -type f -name '*.java' | sort)
כיתה_פלט_מדריך := תוצאה/כיתה_ערך
완료표시 := $(כיתה_פלט_מדריך)/.완료

.PHONY: 모두 검사 ארח 한글검사 נקי_בנה בנה_תמונה

모두: 검사

$(완료표시): $(דור_קודם_מקור_קבצים)
	mkdir -p $(כיתה_פלט_מדריך)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(כיתה_פלט_מדריך) $(דור_קודם_מקור_קבצים)
	touch $(완료표시)

한글검사:
	@sh כלים/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(כיתה_פלט_מדריך) ישראל.JIsrOS.시험.전체시험

ארח: 검사
	$(자바실행기) -cp $(כיתה_פלט_מדריך) ישראל.JIsrOS.ארח.호스트시작

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 דור_קודם_מקור/의 אובייקט_ערך 기반 관리 ליבה_ערך 전체를 AOT 변환하는 대상은 아니다.
בנה_תמונה:
	$(MAKE) -C os iso

נקי_בנה:
	rm -rf תוצאה
