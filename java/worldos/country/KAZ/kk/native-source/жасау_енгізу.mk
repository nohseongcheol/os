자바컴파일러 ?= javac
자바실행기 ?= java
бұрынғы_көз_Файлдар := $(shell find бұрынғы_көз -type f -name '*.java' | sort)
클래스위치 := НӘТИЖЕ/оқу_мән
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 орналастыру 한글검사 Анықтық_құрастыру құрастыру_сурет

모두: 검사

$(완료표시): $(бұрынғы_көз_Файлдар)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(бұрынғы_көз_Файлдар)
	touch $(완료표시)

한글검사:
	@sh Құралдар/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Қазақстан.JKazOS.시험.전체시험

орналастыру: 검사
	$(자바실행기) -cp $(클래스위치) Қазақстан.JKazOS.орналастыру.орналастыру_іске_қосу

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 бұрынғы_көз/의 нысан_мән 기반 관리 ядро_мән 전체를 AOT 변환하는 대상은 아니다.
құрастыру_сурет:
	$(MAKE) -C os iso

Анықтық_құрастыру:
	rm -rf НӘТИЖЕ
