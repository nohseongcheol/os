자바컴파일러 ?= javac
자바실행기 ?= java
мурасталган_башат_Файлдар := $(shell find мурасталган_башат -type f -name '*.java' | sort)
클래스위치 := 결과/класс_маани
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 кабылдоо 한글검사 Таза_курам курам_сүрөт

모두: 검사

$(완료표시): $(мурасталган_башат_Файлдар)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(мурасталган_башат_Файлдар)
	touch $(완료표시)

한글검사:
	@sh Куралдар/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Кыргызстан.JKgzOS.시험.전체시험

кабылдоо: 검사
	$(자바실행기) -cp $(클래스위치) Кыргызстан.JKgzOS.кабылдоо.кабылдоо_жүктөө

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 мурасталган_башат/의 объект_маани 기반 관리 өзөк_маани 전체를 AOT 변환하는 대상은 아니다.
курам_сүрөт:
	$(MAKE) -C os iso

Таза_курам:
	rm -rf 결과
