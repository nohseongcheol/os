/* Deliberate opt-in, limited Linux AArch64 syscall ABI. No Linux kernel/libc.
 * Included after native_system_call so the same pointer/FD checks are reused.
 */
static intptr_t 리눅스체계호출(ຜູ້ໃຊ້_ກອບ *ຟາຍ_ເຂົ້າໃນ) {
    ຜູ້ໃຊ້_ກອບ 변환값 = *ຟາຍ_ເຂົ້າໃນ;
    uintptr_t 수치 = ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[8];
    switch (수치) {
    case 63: 변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 2; break;   /* read */
    case 64: 변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 1; break;   /* write */
    case 57: 변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 4; break;   /* close */
    case 62: 변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 5; break;   /* lseek */
    case 46: 변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 10; break;  /* ftruncate */
    case 82: 변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 12; break;  /* fsync */
    case 56:                              /* openat */
    case 35: {                            /* unlinkat, ordinary files */
        char ທາງໂຄຈອນ[65]; int 반환값 = ກ່າຍ_ທາງໂຄຈອນ(ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[1], ທາງໂຄຈອນ); if (반환값) return 반환값;
        if ((int)ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[0] != -100 && ທາງໂຄຈອນ[0] != '/') return -95;
        if (수치 == 35 && ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[2]) return -95;
        if (수치 == 56 && (ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[2] & ~(0x7fful | 0x80000ul))) return -95;
        변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 수치 == 56 ? 3 : 11;
        변환값.ລົງທະບຽນ_ຂໍ້ມູນ[0] = ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[1];
        변환값.ລົງທະບຽນ_ຂໍ້ມູນ[1] = ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[2] & ~0x80000ul; /* O_CLOEXEC: no execve yet */
        변환값.ລົງທະບຽນ_ຂໍ້ມູນ[2] = ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[3];
        break;
    }
    case 214: {                           /* brk: failure returns old break */
        uintptr_t 이전항목 = 동적기억끝;
        변환값.ລົງທະບຽນ_ຂໍ້ມູນ[8] = 8;
        intptr_t 반환값 = 자체체계호출(&변환값);
        return 반환값 < 0 ? (intptr_t)이전항목 : 반환값;
    }
    case 113: {                           /* clock_gettime, MONOTONIC only */
        if (ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[0] != 1) return -22;
        if (!사용자범위(ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[1], 16, 1)) return -14;
        uint64_t 밀리초 = 보드밀리초(), ຄ່າ[2] = {밀리초 / 1000, (밀리초 % 1000) * 1000000};
        memcpy((void *)ຟາຍ_ເຂົ້າໃນ->ລົງທະບຽນ_ຂໍ້ມູນ[1], ຄ່າ, sizeof(ຄ່າ)); return 0;
    }
    case 172:                             /* getpid */
    case 178: return ເຈົ້າຂອງ_ວັດ_ຖຸ + 1;            /* gettid: one native thread */
    default: return -38;                   /* ENOSYS; never use native numbers */
    }
    return 자체체계호출(&변환값);
}

static uintptr_t 리눅스시작쌓임(uintptr_t ເຂົ້າໃນ_ຈຸດ) {
    uintptr_t 맨위 = ຜູ້ໃຊ້_ຈົບ, 주소목록[8];
    for (unsigned 순번 = 0; 순번 < 전달인수개수; 순번++) {
        unsigned 개수 = 전달인수길이[순번] + 1;
        맨위 -= 개수; memcpy((void *)맨위, 전달인수[순번], 개수); 주소목록[순번] = 맨위;
    }
    /* argc, argv[], NULL, empty envp, AT_PAGESZ, AT_ENTRY, AT_NULL. */
    uintptr_t ກຸ່ມບັດ_ບ່ອນເກັບຂໍ້ມູນ = (맨위 - (전달인수개수 + 9) * sizeof(uint64_t)) & ~15ul;
    uint64_t *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ = (uint64_t *)ກຸ່ມບັດ_ບ່ອນເກັບຂໍ້ມູນ;
    *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 전달인수개수;
    for (unsigned 순번 = 0; 순번 < 전달인수개수; 순번++) *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 주소목록[순번];
    *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 0; *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 0;
    *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 6; *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = ຂະ_ຫນາດ_ຫນ້າ;
    *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 9; *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = ເຂົ້າໃນ_ຈຸດ;
    *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 0; *ຂໍ້ມູນ_ຈັດຕໍາແຫນ່ງ++ = 0;
    return ກຸ່ມບັດ_ບ່ອນເກັບຂໍ້ມູນ;
}
