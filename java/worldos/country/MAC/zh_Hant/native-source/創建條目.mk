Java編譯器 ?= javac
Java啓動器 ?= java
舊的原始碼檔案集 := $(shell find 基礎原始碼 -type f -name '*.java' | sort)
類別輸出目錄 := 結果/類別值
完成狀態標記 := $(類別輸出目錄)/.是否完成

.PHONY: 構建全部 檢查項 宿主 檢查韓文字母 清潔構建 構建映像

構建全部: 檢查項

$(完成狀態標記): $(舊的原始碼檔案集)
	mkdir -p $(類別輸出目錄)
	$(Java編譯器) -encoding UTF-8 -Xlint:all -Werror -d $(類別輸出目錄) $(舊的原始碼檔案集)
	touch $(完成狀態標記)

檢查韓文字母:
	@sh 工具集/標識符檢查.sh

檢查項: 檢查韓文字母 $(完成狀態標記)
	$(Java啓動器) -ea -cp $(類別輸出目錄) 中國澳門特別行政區.JMacOS.測試.測試全部

宿主: 檢查項
	$(Java啓動器) -cp $(類別輸出目錄) 中國澳門特別行政區.JMacOS.宿主.宿主啓動

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 基礎原始碼/의 物件值 基礎 관리 內核值 전체를 AOT 변환하는 대상은 아니다.
構建映像:
	$(MAKE) -C os iso

清潔構建:
	rm -rf 結果
