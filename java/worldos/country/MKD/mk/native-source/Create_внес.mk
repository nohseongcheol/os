자바컴파일러 ?= javac
자바실행기 ?= java
наследен_извор_Датотеки := $(shell find наследен_извор -type f -name '*.java' | sort)
클래스위치 := мерка/класа_VALUE
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 вдоми 한글검사 CLEAN_верзија верзија_IMAGE

모두: 검사

$(완료표시): $(наследен_извор_Датотеки)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(наследен_извор_Датотеки)
	touch $(완료표시)

한글검사:
	@sh Алатки/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Северна_Македонија.JMkdOS.시험.전체시험

вдоми: 검사
	$(자바실행기) -cp $(클래스위치) Северна_Македонија.JMkdOS.вдоми.вдоми_подигање

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 наследен_извор/의 објект_VALUE 기반 관리 јадро_VALUE 전체를 AOT 변환하는 대상은 아니다.
верзија_IMAGE:
	$(MAKE) -C os iso

CLEAN_верзија:
	rm -rf мерка
