/* Deliberate opt-in, limited Linux AArch64 syscall ABI. No Linux kernel/libc.
 * Included after native_system_call so the same pointer/FD checks are reused.
 */
static intptr_t 리눅스체계호출(သုံးစွဲသူဘောင် *ဖိုင်အချက်) {
    သုံးစွဲသူဘောင် 변환값 = *ဖိုင်အချက်;
    uintptr_t ကိန်းဂဏန်းတန်ဖိုး = ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[8];
    switch (ကိန်းဂဏန်းတန်ဖိုး) {
    case 63: 변환값.ဒေတာအမြန်မှတ်ကွက်[8] = 2; break;   /* read */
    case 64: 변환값.ဒေတာအမြန်မှတ်ကွက်[8] = 1; break;   /* write */
    case 57: 변환값.ဒေတာအမြန်မှတ်ကွက်[8] = 4; break;   /* close */
    case 62: 변환값.ဒေတာအမြန်မှတ်ကွက်[8] = 5; break;   /* lseek */
    case 46: 변환값.ဒေတာအမြန်မှတ်ကွက်[8] = 10; break;  /* ftruncate */
    case 82: 변환값.ဒေတာအမြန်မှတ်ကွက်[8] = 12; break;  /* fsync */
    case 56:                              /* openat */
    case 35: {                            /* unlinkat, ordinary files */
        char လမ်း[65]; int ပြန်ပေးတန်ဖိုး = လမ်းကြောင်းမိတ္တူကူး(ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[1], လမ်း); if (ပြန်ပေးတန်ဖိုး) return ပြန်ပေးတန်ဖိုး;
        if ((int)ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[0] != -100 && လမ်း[0] != '/') return -95;
        if (ကိန်းဂဏန်းတန်ဖိုး == 35 && ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[2]) return -95;
        if (ကိန်းဂဏန်းတန်ဖိုး == 56 && (ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[2] & ~(0x7fful | 0x80000ul))) return -95;
        변환값.ဒေတာအမြန်မှတ်ကွက်[8] = ကိန်းဂဏန်းတန်ဖိုး == 56 ? 3 : 11;
        변환값.ဒေတာအမြန်မှတ်ကွက်[0] = ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[1];
        변환값.ဒေတာအမြန်မှတ်ကွက်[1] = ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[2] & ~0x80000ul; /* O_CLOEXEC: no execve yet */
        변환값.ဒေတာအမြန်မှတ်ကွက်[2] = ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[3];
        break;
    }
    case 214: {                           /* brk: failure returns old break */
        uintptr_t ယခင် = ပုံတင်မှတ်ဉာဏ်အဆုံး;
        변환값.ဒေတာအမြန်မှတ်ကွက်[8] = 8;
        intptr_t ပြန်ပေးတန်ဖိုး = ကိုယ်ပိုင်စနစ်ခေါ်(&변환값);
        return ပြန်ပေးတန်ဖိုး < 0 ? (intptr_t)ယခင် : ပြန်ပေးတန်ဖိုး;
    }
    case 113: {                           /* clock_gettime, MONOTONIC only */
        if (ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[0] != 1) return -22;
        if (!သုံးစွဲသူအပိုင်းအခြား(ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[1], 16, 1)) return -14;
        uint64_t မီလီစက္ကန့် = 보드밀리초(), တန်ဖိုး[2] = {မီလီစက္ကန့် / 1000, (မီလီစက္ကန့် % 1000) * 1000000};
        memcpy((void *)ဖိုင်အချက်->ဒေတာအမြန်မှတ်ကွက်[1], တန်ဖိုး, sizeof(တန်ဖိုး)); return 0;
    }
    case 172:                             /* getpid */
    case 178: return ပိုင်ရှင်အရာဝတ္ထု + 1;            /* gettid: one native thread */
    default: return -38;                   /* ENOSYS; never use native numbers */
    }
    return ကိုယ်ပိုင်စနစ်ခေါ်(&변환값);
}

static uintptr_t 리눅스시작쌓임(uintptr_t အချက်အမှတ်တစ်ခု) {
    uintptr_t ထိပ်အချက် = သုံးစွဲသူအဆုံး, လိပ်စာများ[8];
    for (unsigned အစဉ်အမှတ် = 0; အစဉ်အမှတ် < 전달인수개수; အစဉ်အမှတ်++) {
        unsigned အရေအတွက် = 전달인수길이[အစဉ်အမှတ်] + 1;
        ထိပ်အချက် -= အရေအတွက်; memcpy((void *)ထိပ်အချက်, 전달인수[အစဉ်အမှတ်], အရေအတွက်); လိပ်စာများ[အစဉ်အမှတ်] = ထိပ်အချက်;
    }
    /* argc, argv[], NULL, empty envp, AT_PAGESZ, AT_ENTRY, AT_NULL. */
    uintptr_t ထပ်ဆင့်သိုလှောင်ရာ = (ထိပ်အချက် - (전달인수개수 + 9) * sizeof(uint64_t)) & ~15ul;
    uint64_t *ဒေတာနေရာ = (uint64_t *)ထပ်ဆင့်သိုလှောင်ရာ;
    *ဒေတာနေရာ++ = 전달인수개수;
    for (unsigned အစဉ်အမှတ် = 0; အစဉ်အမှတ် < 전달인수개수; အစဉ်အမှတ်++) *ဒေတာနေရာ++ = လိပ်စာများ[အစဉ်အမှတ်];
    *ဒေတာနေရာ++ = 0; *ဒေတာနေရာ++ = 0;
    *ဒေတာနေရာ++ = 6; *ဒေတာနေရာ++ = စာမျက်နှာအရွယ်;
    *ဒေတာနေရာ++ = 9; *ဒေတာနေရာ++ = အချက်အမှတ်တစ်ခု;
    *ဒေတာနေရာ++ = 0; *ဒေတာနေရာ++ = 0;
    return ထပ်ဆင့်သိုလှောင်ရာ;
}
