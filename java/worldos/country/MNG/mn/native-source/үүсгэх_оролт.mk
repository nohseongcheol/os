자바컴파일러 ?= javac
자바실행기 ?= java
хуучин_эх_Файлууд := $(shell find хуучин_эх -type f -name '*.java' | sort)
클래스위치 := 결과/класс_утга
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 хост 한글검사 Цэвэрхэн_хувилбар хувилбар_зураг

모두: 검사

$(완료표시): $(хуучин_эх_Файлууд)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(хуучин_эх_Файлууд)
	touch $(완료표시)

한글검사:
	@sh Хэрэгслүүд/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Монгол_Улс.JMngOS.시험.전체시험

хост: 검사
	$(자바실행기) -cp $(클래스위치) Монгол_Улс.JMngOS.хост.хост_ачаалагч

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 хуучин_эх/의 объект_утга 기반 관리 кернел_утга 전체를 AOT 변환하는 대상은 아니다.
хувилбар_зураг:
	$(MAKE) -C os iso

Цэвэрхэн_хувилбар:
	rm -rf 결과
