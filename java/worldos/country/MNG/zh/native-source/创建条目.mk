Java编译器 ?= javac
Java启动器 ?= java
旧的源代码文件集 := $(shell find 基础源代码 -type f -name '*.java' | sort)
类输出目录 := 结果/类值
完成状态标记 := $(类输出目录)/.是否完成

.PHONY: 构建全部 检查项 宿主 检查韩文字母 清洁构建 构建映像

构建全部: 检查项

$(完成状态标记): $(旧的源代码文件集)
	mkdir -p $(类输出目录)
	$(Java编译器) -encoding UTF-8 -Xlint:all -Werror -d $(类输出目录) $(旧的源代码文件集)
	touch $(完成状态标记)

检查韩文字母:
	@sh 工具集/标识符检查.sh

检查项: 检查韩文字母 $(完成状态标记)
	$(Java启动器) -ea -cp $(类输出目录) 蒙古.JMngOS.测试.测试全部

宿主: 检查项
	$(Java启动器) -cp $(类输出目录) 蒙古.JMngOS.宿主.宿主启动

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 基础源代码/의 对象值 基础 관리 内核值 전체를 AOT 변환하는 대상은 아니다.
构建映像:
	$(MAKE) -C os iso

清洁构建:
	rm -rf 结果
