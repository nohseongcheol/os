자바컴파일러 ?= javac
자바실행기 ?= java
میراث_ماخذ_فائلاں := $(shell find میراث_ماخذ -type f -name '*.java' | sort)
클래스위치 := 결과/درجہ_قدر
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 مہمان_b78e430d 한글검사 정리 بلڈ_نقش

모두: 검사

$(완료표시): $(میراث_ماخذ_فائلاں)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(میراث_ماخذ_فائلاں)
	touch $(완료표시)

한글검사:
	@sh اوزار/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) پاکستان.JPakOS.시험.전체시험

مہمان_b78e430d: 검사
	$(자바실행기) -cp $(클래스위치) پاکستان.JPakOS.مہمان_b78e430d.مہمان_آغاز

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 میراث_ماخذ/의 آبجیکٹ_قدر 기반 관리 کرنل_قدر 전체를 AOT 변환하는 대상은 아니다.
بلڈ_نقش:
	$(MAKE) -C os iso

정리:
	rm -rf 결과
