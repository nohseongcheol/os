자바컴파일러 ?= javac
자바실행기 ?= java
элекке_чыганак_Файллар := $(shell find элекке_чыганак -type f -name '*.java' | sort)
클래스위치 := үлчәм/класс_VALUE
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 хост 한글검사 CLEAN_төзү төзү_IMAGE

모두: 검사

$(완료표시): $(элекке_чыганак_Файллар)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(элекке_чыганак_Файллар)
	touch $(완료표시)

한글검사:
	@sh Кораллар/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Россия.JRusOS.시험.전체시험

хост: 검사
	$(자바실행기) -cp $(클래스위치) Россия.JRusOS.хост.хост_йөкләү

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 элекке_чыганак/의 объект_VALUE 기반 관리 төш_VALUE 전체를 AOT 변환하는 대상은 아니다.
төзү_IMAGE:
	$(MAKE) -C os iso

CLEAN_төзү:
	rm -rf үлчәм
