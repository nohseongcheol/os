    }
    case 214: {                           /* brk: failure returns old break */
        uintptr_t 이전항목 = 동적기억끝;
        변환값.регистровати_подаци[8] = 8;
        intptr_t 반환값 = 자체체계호출(&변환값);
        return 반환값 < 0 ? (intptr_t)이전항목 : 반환값;
    }
    case 113: {                           /* clock_gettime, MONOTONIC only */
        if (фајл_унос->регистровати_подаци[0] != 1) return -22;
        if (!корисник_опсег(фајл_унос->регистровати_подаци[1], 16, 1)) return -14;
        uint64_t 밀리초 = 보드밀리초(), вриједност[2] = {밀리초 / 1000, (밀리초 % 1000) * 1000000};
        memcpy((void *)фајл_унос->регистровати_подаци[1], вриједност, sizeof(вриједност)); return 0;
    }
    case 172:                             /* getpid */
    case 178: return власник_објекат + 1;            /* gettid: one native thread */
