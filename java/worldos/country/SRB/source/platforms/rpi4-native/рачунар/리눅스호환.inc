        if ((int)фајл_унос->регистровати_подаци[0] != -100 && ПУТАЊА[0] != '/') return -95;
        if (수치 == 35 && фајл_унос->регистровати_подаци[2]) return -95;
        if (수치 == 56 && (фајл_унос->регистровати_подаци[2] & ~(0x7fful | 0x80000ul))) return -95;
        변환값.регистровати_подаци[8] = 수치 == 56 ? 3 : 11;
        변환값.регистровати_подаци[0] = фајл_унос->регистровати_подаци[1];
        변환값.регистровати_подаци[1] = фајл_унос->регистровати_подаци[2] & ~0x80000ul; /* O_CLOEXEC: no execve yet */
        변환값.регистровати_подаци[2] = фајл_унос->регистровати_подаци[3];
