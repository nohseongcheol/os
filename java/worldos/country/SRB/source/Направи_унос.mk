자바컴파일러 ?= javac
자바실행기 ?= java
наслијеђе_извор_Фајлови := $(shell find наслијеђе_извор -type f -name '*.java' | sort)
클래스위치 := ИСХОД/класа_вриједност
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 хост 한글검사 Јасноћа_градити градити_слика

모두: 검사

$(완료표시): $(наслијеђе_извор_Фајлови)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(наслијеђе_извор_Фајлови)
	touch $(완료표시)

한글검사:
	@sh Алатке/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Србија.JSrbOS.시험.전체시험

хост: 검사
	$(자바실행기) -cp $(클래스위치) Србија.JSrbOS.хост.хост_покретање

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 наслијеђе_извор/의 објекат_вриједност 기반 관리 језгро_вриједност 전체를 AOT 변환하는 대상은 아니다.
градити_слика:
	$(MAKE) -C os iso

Јасноћа_градити:
	rm -rf ИСХОД
