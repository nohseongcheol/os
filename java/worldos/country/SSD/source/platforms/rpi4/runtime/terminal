#!/bin/sh
. /etc/profile.d/jkoros.sh
if [ "$#" -eq 0 ]; then set -- -e /bin/bash --login; fi
exec /usr/bin/xterm -u8 -fa 'DejaVu Sans Mono' -fd 'Noto Sans Mono CJK KR' \
    -fs 12 -xrm 'XTerm*renderFont: true' \
    -xrm 'XTerm*inputMethod: fcitx' -xrm 'XTerm*openIm: true' \
    -xrm 'XTerm*preeditType: Root' "$@"
