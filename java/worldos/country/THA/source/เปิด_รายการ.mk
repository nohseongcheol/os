자바컴파일러 ?= javac
자바실행기 ?= java
ดั้งเดิม_แหล่ง_ไฟล์ := $(shell find ดั้งเดิม_แหล่ง -type f -name '*.java' | sort)
คลาส_ผลผลิต_ไดเรกทอรี := ผลลัพธ์/คลาส_ค่า
완료표시 := $(คลาส_ผลผลิต_ไดเรกทอรี)/.완료

.PHONY: 모두 검사 โฮสต์ 한글검사 สะอาดตา_รุ่น รุ่น_รูป

모두: 검사

$(완료표시): $(ดั้งเดิม_แหล่ง_ไฟล์)
	mkdir -p $(คลาส_ผลผลิต_ไดเรกทอรี)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(คลาส_ผลผลิต_ไดเรกทอรี) $(ดั้งเดิม_แหล่ง_ไฟล์)
	touch $(완료표시)

한글검사:
	@sh เครื่องมือ/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(คลาส_ผลผลิต_ไดเรกทอรี) ประเทศไทย.JThaOS.시험.전체시험

โฮสต์: 검사
	$(자바실행기) -cp $(คลาส_ผลผลิต_ไดเรกทอรี) ประเทศไทย.JThaOS.โฮสต์.โฮสต์_เริ่มต้นระบบ

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ดั้งเดิม_แหล่ง/의 วัตถุ_ค่า 기반 관리 เคอร์เนล_ค่า 전체를 AOT 변환하는 대상은 아니다.
รุ่น_รูป:
	$(MAKE) -C os iso

สะอาดตา_รุ่น:
	rm -rf ผลลัพธ์
