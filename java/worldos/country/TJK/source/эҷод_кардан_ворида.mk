자바컴파일러 ?= javac
자바실행기 ?= java
ирсӣ_манбаъ_Файлҳо := $(shell find ирсӣ_манбаъ -type f -name '*.java' | sort)
클래스위치 := 결과/синф_қимат
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 мизбон 한글검사 정리 сохт_расм

모두: 검사

$(완료표시): $(ирсӣ_манбаъ_Файлҳо)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ирсӣ_манбаъ_Файлҳо)
	touch $(완료표시)

한글검사:
	@sh Абзорҳо/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Тоҷикистон.JTjkOS.시험.전체시험

мизбон: 검사
	$(자바실행기) -cp $(클래스위치) Тоҷикистон.JTjkOS.мизбон.мизбон_оғози_кор

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ирсӣ_манбаъ/의 объект_қимат 기반 관리 ҳаста_қимат 전체를 AOT 변환하는 대상은 아니다.
сохт_расм:
	$(MAKE) -C os iso

정리:
	rm -rf 결과
