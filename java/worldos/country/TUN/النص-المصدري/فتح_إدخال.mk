자바컴파일러 ?= javac
자바실행기 ?= java
قديم_مصدر_الملفات := $(shell find قديم_مصدر -type f -name '*.java' | sort)
فئة_الناتج_دليل := نتيجة/فئة_قيمة_55654bf1
완료표시 := $(فئة_الناتج_دليل)/.완료

.PHONY: 모두 검사 مضيف 한글검사 نظيف_بنية بنية_صورة

모두: 검사

$(완료표시): $(قديم_مصدر_الملفات)
	mkdir -p $(فئة_الناتج_دليل)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(فئة_الناتج_دليل) $(قديم_مصدر_الملفات)
	touch $(완료표시)

한글검사:
	@sh أدوات/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(فئة_الناتج_دليل) تونس.JTunOS.اختبارات.전체시험

مضيف: 검사
	$(자바실행기) -cp $(فئة_الناتج_دليل) تونس.JTunOS.مضيف.مضيف_بدء_التشغيل

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 قديم_مصدر/의 عنصر_قيمة_2ed200e9 기반 관리 نواة_قيمة 전체를 AOT 변환하는 대상은 아니다.
بنية_صورة:
	$(MAKE) -C os iso

نظيف_بنية:
	rm -rf نتيجة
