자바컴파일러 ?= javac
자바실행기 ?= java
მოძველებული_წყარო_ფაილები := $(shell find მოძველებული_წყარო -type f -name '*.java' | sort)
클래스위치 := გაზომვა/კლასი_მნიშვნელობა
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 მასპინძელი 한글검사 გაწმენდა_აწყობა აწყობა_ნახატი

모두: 검사

$(완료표시): $(მოძველებული_წყარო_ფაილები)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(მოძველებული_წყარო_ფაილები)
	touch $(완료표시)

한글검사:
	@sh ხელსაწყოები/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) თურქეთი.JTurOS.시험.전체시험

მასპინძელი: 검사
	$(자바실행기) -cp $(클래스위치) თურქეთი.JTurOS.მასპინძელი.მასპინძელი_ჩატვირთვა

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 მოძველებული_წყარო/의 ობიექტი_მნიშვნელობა 기반 관리 ბირთვი_მნიშვნელობა 전체를 AOT 변환하는 대상은 아니다.
აწყობა_ნახატი:
	$(MAKE) -C os iso

გაწმენდა_აწყობა:
	rm -rf გაზომვა
