자바컴파일러 ?= javac
자바실행기 ?= java
ранейшых_версій_крыніца_Файлы := $(shell find ранейшых_версій_крыніца -type f -name '*.java' | sort)
클래스위치 := 결과/клас_значэнне
완료표시 := $(클래스위치)/.완료

.PHONY: 모두 검사 вузел 한글검사 Ясны_зборка зборка_выява

모두: 검사

$(완료표시): $(ранейшых_версій_крыніца_Файлы)
	mkdir -p $(클래스위치)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(클래스위치) $(ранейшых_версій_крыніца_Файлы)
	touch $(완료표시)

한글검사:
	@sh Інструменты/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(클래스위치) Украіна.JUkrOS.시험.전체시험

вузел: 검사
	$(자바실행기) -cp $(클래스위치) Украіна.JUkrOS.вузел.вузел_запуск

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 ранейшых_версій_крыніца/의 аб_ект_значэнне 기반 관리 ядро_значэнне 전체를 AOT 변환하는 대상은 아니다.
зборка_выява:
	$(MAKE) -C os iso

Ясны_зборка:
	rm -rf 결과
