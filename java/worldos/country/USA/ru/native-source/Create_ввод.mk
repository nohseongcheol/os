자바컴파일러 ?= javac
자바실행기 ?= java
устаревший_источник_Файлы := $(shell find устаревший_источник -type f -name '*.java' | sort)
Класс_выход_Каталог := результат/Класс_ЗНАЧЕН
완료표시 := $(Класс_выход_Каталог)/.완료

.PHONY: 모두 검사 узел 한글검사 ПЕЧСИМВ_BLD BLD_фото

모두: 검사

$(완료표시): $(устаревший_источник_Файлы)
	mkdir -p $(Класс_выход_Каталог)
	$(자바컴파일러) -encoding UTF-8 -Xlint:all -Werror -d $(Класс_выход_Каталог) $(устаревший_источник_Файлы)
	touch $(완료표시)

한글검사:
	@sh инструменты/한글이름검사.sh

검사: 한글검사 $(완료표시)
	$(자바실행기) -ea -cp $(Класс_выход_Каталог) Соединенные_Штаты.JUsaOS.испытания.전체시험

узел: 검사
	$(자바실행기) -cp $(Класс_выход_Каталог) Соединенные_Штаты.JUsaOS.узел.узел_запуск

# 별도 os/의 제한형 Java 네이티브 커널을 빌드한다.
# 기존 устаревший_источник/의 объект_ЗНАЧЕН 기반 관리 ядро_ЗНАЧЕН 전체를 AOT 변환하는 대상은 아니다.
BLD_фото:
	$(MAKE) -C os iso

ПЕЧСИМВ_BLD:
	rm -rf результат
